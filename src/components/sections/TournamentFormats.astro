---
import { Icon } from 'astro-icon/components';
import { t, type Locale } from '~/utils/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

interface FormatCard { icon: string; tone: string; tag: string; title: string; body: string }

const data = t<{
  title: { lead: string; ital: string };
  body: string;
  cards: FormatCard[];
  footer: string;
}>(locale, 'tournament-formats');
---

<section id="tournament-formats" class="py-12 md:py-16">
  <div class="max-w-[1280px] mx-auto px-5 md:px-8 w-full">
    <div class="section-head" data-scroll>
      <h2 class="section-title text-white">
        {data.title.lead} <span class="ital-grad">{data.title.ital}</span>
      </h2>
      <p class="section-sub">{data.body}</p>
    </div>

    <div class="tf-cards" data-scroll>
      {
        data.cards.map((c) => (
          <article class="tf-card">
            <div class="tf-card__top">
              <span class="gradient-tile" data-tone={c.tone}>
                <Icon name={c.icon} class="w-5 h-5" />
              </span>
              <span class="tf-card__tag">{c.tag}</span>
            </div>
            <h3 class="tf-card__title text-white">{c.title}</h3>
            <p class="tf-card__body">{c.body}</p>
          </article>
        ))
      }
    </div>

    <p class="tf-footer" data-scroll>
      <Icon name="tabler:rosette-discount-check" class="w-4 h-4" />{data.footer}
    </p>
  </div>
</section>

<style>
  .tf-cards {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
    margin: 0 0 1.5rem;
  }
  .tf-card {
    display: flex; flex-direction: column; gap: 0.7rem;
    padding: clamp(1.2rem, 2.5vw, 1.6rem); border-radius: var(--radius-2xl);
    background: var(--glass-card-bg); border: 1px solid var(--hairline);
    box-shadow: var(--shadow-soft-chrome);
    transition: transform 250ms ease, border-color 250ms ease;
  }
  .tf-card:hover { transform: translateY(-4px); border-color: var(--hairline-strong); }
  .tf-card__top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .tf-card__tag {
    font-family: var(--font-mono); font-size: 0.58rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted);
    padding: 0.3rem 0.6rem; border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid var(--hairline);
  }
  .tf-card__title { font-family: var(--font-sans); font-size: 1.2rem; font-weight: 500; letter-spacing: -0.01em; margin-top: 0.2rem; }
  .tf-card__body { font-size: 0.92rem; line-height: 1.55; color: var(--ink-muted); }

  .tf-footer {
    display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    text-align: center; font-size: 0.92rem; color: var(--ink-muted);
  }
  .tf-footer svg { color: var(--brand-lavender); flex: none; }

  @media (max-width: 880px) { .tf-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .tf-cards { grid-template-columns: 1fr; } }
</style>
