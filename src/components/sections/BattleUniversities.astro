---
import { type Locale } from '~/utils/i18n';
import BattleIsland from '~/components/battle-of-universities/BattleIsland';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
void locale;
---

<section id="battle-universities" class="py-12 md:py-16">
  <div class="max-w-[1280px] mx-auto px-5 md:px-8 w-full">
    <BattleIsland client:visible prizePool={100000} />
  </div>
</section>
