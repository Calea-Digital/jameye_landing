---
import { Icon } from 'astro-icon/components';
import { t, type Locale } from '~/utils/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

interface Card { icon: string; tone: string; title: string; body: string }

const data = t<{
  title: { lead: string; ital: string };
  sub: string;
  cards: Card[];
  sim: {
    title: string;
    sub: string;
    sliderLabel: string;
    sliderEnds: { few: string; many: string };
    legend: { calibrated: string; random: string };
    axis: { worse: string; average: string; better: string };
    verdicts: { few: string; some: string; many: string; settled: string };
  };
}>(locale, 'calibration');

// Number of score buckets along the x-axis (worse → better).
const BUCKETS = 32;
const buckets = Array.from({ length: BUCKETS }, (_, i) => i);
---

<section id="why-skill" class="py-12 md:py-16">
  <div class="max-w-[1280px] mx-auto px-5 md:px-8 w-full">
    <div class="section-head" data-scroll>
      <h2 class="section-title text-white">
        {data.title.lead} <span class="ital-grad">{data.title.ital}</span>
      </h2>
      <p class="section-sub">{data.sub}</p>
    </div>

    <!-- Three pillars -->
    <div class="cal-cards" data-scroll>
      {
        data.cards.map((c) => (
          <article class="cal-card">
            <span class="gradient-tile" data-tone={c.tone}>
              <Icon name={c.icon} class="w-5 h-5" />
            </span>
            <h3 class="cal-card__title text-white">{c.title}</h3>
            <p class="cal-card__body">{c.body}</p>
          </article>
        ))
      }
    </div>

    <!-- Interactive simulation -->
    <div class="cal-sim" data-cal-sim data-scroll>
      <div class="cal-sim__head">
        <h3 class="cal-sim__title text-white">{data.sim.title}</h3>
        <p class="cal-sim__sub">{data.sim.sub}</p>
      </div>

      <div class="cal-sim__legend">
        <span class="cal-leg cal-leg--cal"><span class="cal-leg__dot" />{data.sim.legend.calibrated}</span>
        <span class="cal-leg cal-leg--rand"><span class="cal-leg__dot" />{data.sim.legend.random}</span>
      </div>

      <!-- Histogram: one stacked column per score bucket (lucky guesser at
           the base, calibrated forecaster stacked on top). -->
      <div class="cal-chart" role="img" aria-label={data.sim.title}>
        <div class="cal-bars">
          {
            buckets.map((i) => (
              <div class="cal-group" data-bucket={i}>
                <span class="cal-bar cal-bar--cal" data-bar="cal" style="height:0%"></span>
                <span class="cal-bar cal-bar--rand" data-bar="rand" style="height:0%"></span>
              </div>
            ))
          }
        </div>
        <div class="cal-axis">
          <span>{data.sim.axis.worse}</span>
          <span>{data.sim.axis.average}</span>
          <span>{data.sim.axis.better}</span>
        </div>
      </div>

      <!-- Slider -->
      <div class="cal-control">
        <label class="cal-control__label" for="cal-slider">{data.sim.sliderLabel}</label>
        <input
          id="cal-slider"
          class="cal-slider"
          type="range"
          min="0"
          max="100"
          value="6"
          step="1"
          data-cal-slider
          aria-label={data.sim.sliderLabel}
        />
        <div class="cal-control__ends">
          <span>{data.sim.sliderEnds.few}</span>
          <span>{data.sim.sliderEnds.many}</span>
        </div>
        <p class="cal-verdict" data-cal-verdict aria-live="polite">{data.sim.verdicts.few}</p>
      </div>

      <script type="application/json" data-cal-verdicts set:html={JSON.stringify(data.sim.verdicts)} />
    </div>
  </div>
</section>

<style>
  /* ---- Pillars — span the full content width, like the nav/CTA ---- */
  .cal-cards {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
    margin: 0 0 1.5rem;
  }
  .cal-card {
    display: flex; flex-direction: column; gap: 0.7rem;
    padding: clamp(1.1rem, 2.5vw, 1.5rem); border-radius: var(--radius-2xl);
    background: var(--glass-card-bg); border: 1px solid var(--hairline);
    box-shadow: var(--shadow-soft-chrome);
  }
  .cal-card__title { font-family: var(--font-sans); font-size: 1.1rem; font-weight: 500; letter-spacing: -0.01em; }
  .cal-card__body { font-size: 0.92rem; line-height: 1.55; color: var(--ink-muted); }
  @media (max-width: 720px) { .cal-cards { grid-template-columns: 1fr; } }

  /* ---- Simulation card — full content width ---- */
  .cal-sim {
    padding: clamp(1.5rem, 3.5vw, 2.5rem); border-radius: var(--radius-2xl);
    background: var(--glass-card-bg); border: 1px solid var(--hairline);
    box-shadow: var(--shadow-soft-chrome);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  }
  .cal-sim__head { text-align: center; max-width: 42rem; margin: 0 auto 1.25rem; }
  .cal-sim__title { font-family: var(--font-sans); font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 400; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 0.6rem; }
  .cal-sim__sub { font-size: 0.95rem; line-height: 1.55; color: var(--ink-muted); }

  .cal-sim__legend { display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 1rem; }
  .cal-leg {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.62rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted);
  }
  .cal-leg__dot { width: 0.7rem; height: 0.7rem; border-radius: 0.2rem; flex: none; }
  .cal-leg--cal .cal-leg__dot { background: var(--win-emerald); box-shadow: 0 0 12px -2px var(--win-emerald); }
  .cal-leg--rand .cal-leg__dot { background: var(--alert-rose); box-shadow: 0 0 12px -2px var(--alert-rose); }

  /* Histogram */
  .cal-chart {
    background: rgba(0, 0, 0, 0.3); border: 1px solid var(--hairline);
    border-radius: 1.25rem; padding: clamp(1rem, 2.5vw, 1.5rem);
  }
  .cal-bars {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: clamp(1px, 0.35vw, 3px); height: clamp(160px, 26vw, 240px);
  }
  /* Each column stacks lucky-guesser (bottom) + calibrated (top). */
  .cal-group {
    display: flex; flex-direction: column-reverse; align-items: stretch;
    flex: 1; height: 100%; overflow: hidden;
  }
  .cal-bar {
    width: 100%; border-radius: 0;
    transition: height 560ms cubic-bezier(0.2, 0.85, 0.2, 1);
    will-change: height;
  }
  .cal-bar--rand {
    background: linear-gradient(180deg, var(--alert-rose), rgba(244, 63, 94, 0.45));
  }
  .cal-bar--cal {
    background: linear-gradient(180deg, var(--win-emerald), rgba(16, 185, 129, 0.5));
    border-radius: 2px 2px 0 0;
  }
  /* When the column is pure lucky-guesser, round its top too. */
  .cal-group[data-pure="rand"] .cal-bar--rand { border-radius: 2px 2px 0 0; }

  .cal-axis {
    display: flex; justify-content: space-between; margin-top: 0.75rem;
    font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  .cal-axis span:nth-child(2) { color: var(--ink-muted); }

  /* Slider */
  .cal-control { margin-top: 1.5rem; max-width: 38rem; margin-left: auto; margin-right: auto; }
  .cal-control__label { display: block; text-align: center; margin-bottom: 0.7rem; font-family: var(--font-mono); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted); }

  .cal-slider { -webkit-appearance: none; appearance: none; width: 100%; height: 8px; border-radius: 9999px; background: rgba(255, 255, 255, 0.1); outline: none; cursor: pointer; }
  .cal-slider::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 26px; height: 26px; border-radius: 9999px;
    background: #fff; border: 3px solid var(--brand-purple); box-shadow: 0 6px 20px rgba(126, 59, 255, 0.7); cursor: pointer;
    transition: transform 160ms ease;
  }
  .cal-slider::-webkit-slider-thumb:hover { transform: scale(1.12); }
  .cal-slider::-moz-range-thumb {
    width: 26px; height: 26px; border-radius: 9999px; background: #fff;
    border: 3px solid var(--brand-purple); box-shadow: 0 6px 20px rgba(126, 59, 255, 0.7); cursor: pointer;
  }
  .cal-control__ends {
    display: flex; justify-content: space-between; margin-top: 0.55rem;
    font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint);
  }

  .cal-verdict { margin-top: 1rem; text-align: center; font-size: 0.92rem; line-height: 1.5; color: var(--ink-muted); min-height: 2.6em; }

  @media (prefers-reduced-motion: reduce) {
    .cal-bar { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cal-sim]').forEach((root) => {
    const slider = root.querySelector<HTMLInputElement>('[data-cal-slider]');
    const verdictEl = root.querySelector<HTMLElement>('[data-cal-verdict]');
    const groups = Array.from(root.querySelectorAll<HTMLElement>('.cal-group'));
    const verdictsRaw = root.querySelector<HTMLElement>('[data-cal-verdicts]')?.textContent ?? '{}';
    if (!slider || !groups.length) return;

    const verdicts = JSON.parse(verdictsRaw) as { few: string; some: string; many: string; settled: string };
    const BUCKETS = groups.length;

    const gauss = (x: number, mu: number, s: number) => Math.exp(-((x - mu) ** 2) / (2 * s * s));
    const clamp01 = (v: number) => Math.max(0, Math.min(1, v));

    // p = slider progression (0..1). The histogram morphs from a red field
    // of lucky guessers piled at the worse scores into a green cluster of
    // calibrated forecasters at the top scores.
    //   • Lucky guessers (red): start dominant at the low end, fade to nothing
    //     by ~80% progression.
    //   • Calibrated forecasters (green): appear around 25% progression, then
    //     migrate rightward and tighten as more predictions resolve.
    const render = (p: number) => {
      const randAmp = clamp01(1 - p / 0.8);                 // gone by p≈0.8
      const randMu = 0.2;
      const randSig = 0.16;

      const greenAmp = clamp01((p - 0.22) / 0.5);           // emerges ~0.22
      const greenMu = 0.46 + 0.34 * p;                      // middle → high
      const greenSig = 0.2 - 0.1 * p;                       // tightens

      groups.forEach((g, i) => {
        const x = i / (BUCKETS - 1);
        const rand = randAmp * gauss(x, randMu, randSig);
        const cal = greenAmp * gauss(x, greenMu, greenSig);
        const rBar = g.querySelector<HTMLElement>('[data-bar="rand"]');
        const cBar = g.querySelector<HTMLElement>('[data-bar="cal"]');
        // Scale to % of column height; cap the stack at 96%.
        let rPct = rand * 92;
        let cPct = cal * 92;
        if (rPct + cPct > 96) { const k = 96 / (rPct + cPct); rPct *= k; cPct *= k; }
        if (rBar) rBar.style.height = `${rPct.toFixed(1)}%`;
        if (cBar) cBar.style.height = `${cPct.toFixed(1)}%`;
        g.dataset.pure = cPct < 1 ? 'rand' : '';
      });

      if (verdictEl) {
        verdictEl.textContent =
          p < 0.18 ? verdicts.few :
          p < 0.45 ? verdicts.some :
          p < 0.78 ? verdicts.many : verdicts.settled;
      }
    };

    slider.addEventListener('input', () => render(Number(slider.value) / 100));

    // Paint once when the section scrolls into view (animates from 0).
    let painted = false;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !painted) {
          painted = true;
          render(Number(slider.value) / 100);
        }
      });
    }, { threshold: 0.25 });
    io.observe(root);
  });
</script>
