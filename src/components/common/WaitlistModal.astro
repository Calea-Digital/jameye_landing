---
import { Icon } from 'astro-icon/components';
import { t, type Locale } from '~/utils/i18n';
import { TELEGRAM_URL } from '~/config';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const w = t<{
  badge: string;
  title: string;
  subtitle: string;
  fields: { email: string; nickname: string; referred: string; avatar: string };
  placeholders: { email: string; nickname: string; referred: string };
  help: { email: string; nickname: string; referred: string; avatar: string };
  status: { checking: string; emailOk: string; nickOk: string };
  avatarLabels: { avatar_1: string; avatar_2: string; avatar_3: string; avatar_4: string };
  submit: string;
  submitting: string;
  generating: string;
  close: string;
  errors: { email: string; emailTaken: string; nicknameTaken: string; generic: string };
  success: {
    title: string; sub: string; handleLabel: string; positionLabel: string; linkLabel: string;
    copy: string; copied: string; earn: string; positionNote: string; done: string;
  };
}>(locale, 'waitlist');

// The four selectable avatars. The value submitted to the form is the id
// ("avatar_1" … "avatar_4") so the team knows which to render per user.
// Inlined so they can be normalized to a uniform size on open (getBBox).
import av1 from '../../../public/avatar/01-open-market-trader.svg?raw';
import av2 from '../../../public/avatar/02-edge-score-explorer.svg?raw';
import av3 from '../../../public/avatar/03-duel-customizable-fighter.svg?raw';
import av4 from '../../../public/avatar/04-rapid-duel-fighter.svg?raw';

const AVATARS = [
  { id: 'avatar_1', svg: av1, label: w.avatarLabels.avatar_1 },
  { id: 'avatar_2', svg: av2, label: w.avatarLabels.avatar_2 },
  { id: 'avatar_3', svg: av3, label: w.avatarLabels.avatar_3 },
  { id: 'avatar_4', svg: av4, label: w.avatarLabels.avatar_4 },
];

const CFG = {
  apiBase: 'https://waitlist.jameye.com',
};
---

<div class="wl-overlay" data-waitlist-modal hidden>
  <div class="wl-panel" role="dialog" aria-modal="true" aria-labelledby="wl-title">
    <button type="button" class="wl-close" data-wl-close aria-label={w.close}>
      <Icon name="tabler:x" class="w-4 h-4" />
    </button>

    <!-- ===== Form view ===== -->
    <div data-wl-formview>
      <span class="wl-badge">{w.badge}</span>
      <h2 id="wl-title" class="wl-title">{w.title}</h2>
      <p class="wl-sub">{w.subtitle}</p>

      <form class="mt-6 flex flex-col gap-4" data-wl-form novalidate>
        <div class="wl-grid">
        <div class="wl-field">
          <label class="wl-label" for="wl-email">{w.fields.email}<span class="wl-req">*</span></label>
          <input id="wl-email" class="waitlist-input w-full" type="email" name="email" required autocomplete="email" placeholder={w.placeholders.email} data-wl-email />
          <p class="wl-help">{w.help.email}</p>
          <p class="wl-status hidden" data-wl-status-email aria-live="polite"></p>
        </div>

        <div class="wl-field">
          <label class="wl-label" for="wl-nickname">{w.fields.nickname}</label>
          <input id="wl-nickname" class="waitlist-input w-full" type="text" name="nickname" autocomplete="off" placeholder={w.placeholders.nickname} data-wl-nickname />
          <p class="wl-help">{w.help.nickname}</p>
          <p class="wl-status hidden" data-wl-status-nick aria-live="polite"></p>
        </div>

        <div class="wl-field wl-field--full">
          <label class="wl-label" for="wl-referred">{w.fields.referred}</label>
          <input id="wl-referred" class="waitlist-input w-full" type="text" name="referred" autocomplete="off" placeholder={w.placeholders.referred} data-wl-referred />
          <p class="wl-help">{w.help.referred}</p>
        </div>
        </div>

        <div class="wl-field">
          <label class="wl-label">{w.fields.avatar}</label>
          <div class="wl-avatars" role="radiogroup" aria-label={w.fields.avatar}>
            {AVATARS.map((a, i) => (
              <button
                type="button"
                class:list={['wl-avatar', i === 0 && 'is-selected']}
                data-avatar-opt={a.id}
                role="radio"
                aria-checked={i === 0 ? 'true' : 'false'}
                title={a.label}
                aria-label={a.label}
              >
                <span class="wl-avatar-art" set:html={a.svg} />
              </button>
            ))}
          </div>
          <input type="hidden" data-wl-avatar value="avatar_1" />
          <p class="wl-help">{w.help.avatar}</p>
        </div>

        <p class="wl-error hidden" data-wl-error aria-live="polite"></p>

        <div class="wl-submit-row mt-1">
          <button type="submit" class="tactical-cta wl-submit-btn" data-wl-submit>
            <span class="tactical-cta-inner font-extrabold">
              <span data-wl-submit-label>{w.submit}</span>
              <Icon name="tabler:arrow-right" class="w-3.5 h-3.5" />
            </span>
          </button>
          <a
            href={TELEGRAM_URL}
            class="wl-telegram"
            aria-label="Join our Telegram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="tabler:brand-telegram" class="w-5 h-5" />
          </a>
        </div>
      </form>
    </div>

    <!-- ===== Success view ===== -->
    <div class="wl-success" data-wl-success hidden>
      <div class="wl-success__check"><Icon name="tabler:circle-check" class="w-7 h-7" /></div>
      <h2 class="wl-success__title text-white">{w.success.title}</h2>
      <p class="wl-success__sub">{w.success.sub}</p>

      <div class="wl-cards">
        <div class="wl-handle">
          <span class="wl-handle__k">{w.success.handleLabel}</span>
          <span class="wl-handle__v" data-wl-handle>—</span>
        </div>
        <!-- Position is resolved from the live waitlist count after signup, so
             it stays hidden if that call fails rather than showing a stale "—". -->
        <div class="wl-handle wl-handle--pos" data-wl-position-card hidden>
          <span class="wl-handle__k">{w.success.positionLabel}</span>
          <span class="wl-handle__v" data-wl-position>—</span>
        </div>
      </div>

      <label class="wl-label mt-1 block text-left">{w.success.linkLabel}</label>
      <div class="wl-linkrow">
        <input type="text" class="waitlist-input wl-linkinput" data-wl-link readonly aria-label={w.success.linkLabel} />
        <button type="button" class="tactical-cta wl-copy" data-wl-copy>
          <span class="tactical-cta-inner font-extrabold">
            <Icon name="tabler:copy" class="w-3.5 h-3.5" />
            <span data-wl-copy-label>{w.success.copy}</span>
          </span>
        </button>
      </div>
      <p class="wl-help mt-2" data-wl-earn>{w.success.earn}</p>

      <button type="button" class="wl-done" data-wl-close>{w.success.done}</button>
    </div>
  </div>
</div>

<style>
  /* Styled to match the play landing (src/components/play-landing): brand
     gradient card, glass surfaces, Figtree heavy uppercase headings and the
     skewed "tactical" CTA. Behaviour/markup hooks (data-wl-*) are unchanged. */
  .wl-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    /* flex-start + margin:auto on the panel centers it when it fits but lets
       the overlay scroll cleanly (no clipped top) on short viewports. */
    align-items: flex-start;
    justify-content: center;
    padding: 1rem;
    background: rgba(5, 6, 15, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 200ms ease;
    overflow-y: auto;
    font-family: var(--font-display);
    font-weight: 500;
    color: #fff;
  }
  .wl-overlay[hidden] { display: none; }
  .wl-overlay.is-open { opacity: 1; }

  .wl-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    max-width: 42rem;
    margin: auto;
    padding: 1.5rem;
    border-radius: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: linear-gradient(135deg, #EC4899 0%, #6366F1 50%, #22D3EE 100%);
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    transform: translateY(24px) scale(0.96);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (min-width: 640px) { .wl-panel { padding: 2.25rem; } }
  .wl-overlay.is-open .wl-panel { transform: translateY(0) scale(1); }
  /* Drifting light orbs like the landing cards */
  .wl-panel::before, .wl-panel::after {
    content: '';
    position: absolute;
    z-index: -1;
    width: 16rem; height: 16rem;
    border-radius: 9999px;
    filter: blur(80px);
    pointer-events: none;
    animation: orb-drift 7s ease-in-out infinite;
  }
  .wl-panel::before { top: -5rem; right: -5rem; background: rgba(255, 255, 255, 0.28); }
  .wl-panel::after  { bottom: -5rem; left: -5rem; background: rgba(34, 211, 238, 0.35); animation-delay: 1.5s; }

  .wl-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    color: #fff;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(6px);
    transition: background 150ms ease, transform 150ms ease;
  }
  .wl-close:hover { background: rgba(255, 255, 255, 0.35); transform: rotate(90deg); }

  .wl-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    padding: 0.25rem 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.2;
    color: #fff;
  }
  .wl-title {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.7rem, 6vw, 2.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #fff;
    text-wrap: balance;
  }
  .wl-sub { margin-top: 0.75rem; font-size: 0.9rem; line-height: 1.55; color: rgba(255, 255, 255, 0.9); max-width: 34rem; }

  .wl-grid { display: grid; grid-template-columns: 1fr; gap: 1rem 1.25rem; align-items: start; }
  @media (min-width: 480px) {
    .wl-grid { grid-template-columns: 1fr 1fr; }
    .wl-field--full { grid-column: 1 / -1; }
  }
  .wl-field { display: flex; flex-direction: column; gap: 0.4rem; }
  .wl-label {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }
  .wl-req { color: #fff; margin-left: 0.2em; }

  /* Glass inputs (override the global .waitlist-input chrome) */
  .wl-overlay .waitlist-input {
    flex: 0 0 auto;
    height: auto;
    padding: 0.8rem 1rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.22);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.5);
    transition: border-color 150ms ease, background 150ms ease, box-shadow 150ms ease;
  }
  .wl-overlay .waitlist-input::placeholder { color: rgba(255, 255, 255, 0.65); font-weight: 500; }
  .wl-overlay .waitlist-input:focus {
    outline: none;
    border-color: #fff;
    background: rgba(255, 255, 255, 0.32);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.3);
  }
  .wl-overlay .waitlist-input:disabled { opacity: 0.6; }

  /* Submit row — skewed tactical CTA + Telegram shortcut sitting to its right. */
  .wl-submit-row { display: flex; gap: 0.75rem; align-items: stretch; }
  .wl-submit-btn {
    flex: 1 1 auto;
    padding: 0.95rem 1.5rem;
    font-size: 0.95rem;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 14px 34px -12px rgba(5, 6, 15, 0.7);
  }
  .wl-submit-btn:hover:not(:disabled) { filter: brightness(1.08); transform: skewX(-12deg) translateY(-1px); }
  .wl-submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .wl-telegram {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    border-radius: 0.5rem;
    color: #fff;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(6px);
    transition: background 150ms ease, transform 150ms ease;
  }
  .wl-telegram:hover { background: rgba(255, 255, 255, 0.35); transform: translateY(-1px); }
  .wl-help { font-size: 0.72rem; line-height: 1.4; color: rgba(255, 255, 255, 0.75); }
  .wl-error { font-size: 0.85rem; font-weight: 700; color: #fff; background: rgba(5, 6, 15, 0.35); border-radius: 0.6rem; padding: 0.5rem 0.75rem; }
  .wl-error.hidden { display: none; }

  /* Live-validation feedback */
  .wl-overlay .waitlist-input.is-valid { border-color: #34D399 !important; box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.35); }
  .wl-overlay .waitlist-input.is-invalid { border-color: #FDA4AF !important; box-shadow: 0 0 0 3px rgba(253, 164, 175, 0.35); }
  .wl-status { font-size: 0.72rem; font-weight: 700; line-height: 1.4; display: flex; align-items: center; gap: 0.3rem; }
  .wl-status.ok { color: #A7F3D0; }
  .wl-status.bad { color: #FECDD3; }
  .wl-status.checking { color: rgba(255, 255, 255, 0.7); }

  /* Avatar picker — glass tiles, the selected one lights up white */
  .wl-avatars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; }
  .wl-avatar {
    aspect-ratio: 1;
    border-radius: 1rem;
    border: 2px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    cursor: pointer;
    overflow: hidden;
    backdrop-filter: blur(6px);
    transition: border-color 150ms ease, transform 150ms ease, background 150ms ease, box-shadow 150ms ease;
  }
  .wl-avatar-art { display: block; width: 100%; height: 100%; }
  .wl-avatar-art svg { width: 100%; height: 100%; display: block; }
  .wl-avatar:hover { transform: translateY(-3px); background: rgba(255, 255, 255, 0.28); }
  .wl-avatar.is-selected {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.7), 0 14px 30px -12px rgba(0, 0, 0, 0.5);
    transform: translateY(-3px) scale(1.03);
  }

  /* ===== Success view ===== */
  .wl-success { text-align: center; }
  .wl-success[hidden] { display: none; }
  .wl-success__check {
    width: 3.75rem; height: 3.75rem; margin: 0.25rem auto 1rem;
    display: flex; align-items: center; justify-content: center;
    border-radius: 9999px; color: #fff;
    background: rgba(255, 255, 255, 0.22); border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 40px -6px rgba(255, 255, 255, 0.6);
    animation: pop-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .wl-success__title {
    font-family: var(--font-display); font-weight: 900; text-transform: uppercase;
    font-size: clamp(1.7rem, 6vw, 2.6rem); letter-spacing: -0.02em; line-height: 1.02; color: #fff;
  }
  .wl-success__sub { margin-top: 0.6rem; font-size: 0.9rem; color: rgba(255, 255, 255, 0.9); }

  .wl-cards {
    display: grid; grid-template-columns: 1fr; gap: 0.75rem;
    margin: 1.5rem auto 1.25rem; max-width: 26rem;
  }
  @media (min-width: 480px) {
    .wl-cards { grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); }
  }
  .wl-handle {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.35rem;
    padding: 1rem 1.25rem; min-width: 0;
    border-radius: 1.25rem; background: rgba(255, 255, 255, 0.22); border: 1px solid rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(8px);
  }
  .wl-handle[hidden] { display: none; }
  .wl-handle--pos .wl-handle__v { font-variant-numeric: tabular-nums; }
  .wl-handle__k { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); }
  .wl-handle__v {
    font-family: var(--font-display); font-size: 1.5rem; font-weight: 900; letter-spacing: -0.02em; color: #fff;
    text-align: center; overflow-wrap: anywhere;
  }

  .wl-linkrow { display: flex; gap: 0.5rem; margin-top: 0.4rem; }
  .wl-linkinput { flex: 1 1 auto; width: 100%; min-width: 0; font-family: var(--font-mono) !important; font-size: 0.8rem !important; }
  .wl-copy { flex: 0 0 auto; padding: 0.8rem 1.1rem; font-size: 0.8rem; text-transform: uppercase; }
  .wl-copy.is-copied { background: linear-gradient(135deg, #34D399 0%, #22D3EE 100%); }

  .wl-done {
    width: 100%; margin-top: 1.25rem; padding: 0.9rem 1.25rem;
    border-radius: 0.75rem; border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.2); color: #fff;
    font-family: var(--font-display); font-weight: 800; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase;
    backdrop-filter: blur(6px);
    transition: background 150ms ease;
  }
  .wl-done:hover { background: rgba(255, 255, 255, 0.32); }

  @media (prefers-reduced-motion: reduce) {
    .wl-overlay, .wl-panel, .wl-avatar, .wl-close { transition: none; }
    .wl-panel::before, .wl-panel::after, .wl-success__check { animation: none; }
  }
</style>

<script define:vars={{ CFG, ERR: w.errors, STATUS: w.status, SUBMIT_LABEL: w.submit, SUBMITTING_LABEL: w.submitting, GENERATING_LABEL: w.generating, COPY_LABEL: w.success.copy, COPIED_LABEL: w.success.copied, POSITION_NOTE: w.success.positionNote, LOCALE: locale }}>
  const overlay = document.querySelector('[data-waitlist-modal]');
  if (overlay) {
    const $ = (s) => overlay.querySelector(s);
    const formView = $('[data-wl-formview]');
    const form = $('[data-wl-form]');
    const emailEl = $('[data-wl-email]');
    const nickEl = $('[data-wl-nickname]');
    const refEl = $('[data-wl-referred]');
    const avatarEl = $('[data-wl-avatar]');
    const statusEmail = $('[data-wl-status-email]');
    const statusNick = $('[data-wl-status-nick]');
    const errEl = $('[data-wl-error]');
    const successEl = $('[data-wl-success]');
    const handleEl = $('[data-wl-handle]');
    const positionCard = $('[data-wl-position-card]');
    const positionEl = $('[data-wl-position]');
    const earnEl = $('[data-wl-earn]');
    const linkEl = $('[data-wl-link]');
    const copyBtn = $('[data-wl-copy]');
    const copyLabel = $('[data-wl-copy-label]');
    const submitBtn = $('[data-wl-submit]');
    const submitLabel = $('[data-wl-submit-label]');
    let lastFocused = null;

    // ---- Avatar selection ----
    overlay.querySelectorAll('[data-avatar-opt]').forEach((btn) => {
      btn.addEventListener('click', () => {
        overlay.querySelectorAll('[data-avatar-opt]').forEach((b) => {
          b.classList.remove('is-selected');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-checked', 'true');
        avatarEl.value = btn.getAttribute('data-avatar-opt');
      });
    });

    // ---- Backend uniqueness probe ----
    const checkUnique = async (params) => {
      if (!CFG.apiBase) return null;
      const qs = new URLSearchParams();
      if (params.email) qs.set('email', params.email);
      if (params.nickname) qs.set('nickname', params.nickname);
      try {
        const res = await fetch(`${CFG.apiBase}/api/waitlist/check?${qs.toString()}`, { cache: 'no-store' });
        if (!res.ok) return null;
        return await res.json();
      } catch {
        return null;
      }
    };

    // ---- Auto-generated handle (forecaster archetype + flavour + number) ----
    const ADJ = ['Patient', 'Bold', 'Lucky', 'Sly', 'Calm', 'Sharp', 'Wise', 'Swift', 'Keen', 'Cosmic', 'Quiet', 'Fearless', 'Steady', 'Curious', 'Mystic', 'Golden', 'Silent', 'Restless', 'Humble', 'Reckless'];
    const ARCH = ['Oracle', 'Prophet', 'Seer', 'Analyst', 'Sage', 'Augur', 'Pundit', 'Diviner', 'Soothsayer', 'Visionary', 'Strategist', 'Quant', 'Scout', 'Sentinel', 'Navigator', 'Pathfinder', 'Forecaster'];
    const CRIT = ['Slug', 'Owl', 'Fox', 'Falcon', 'Lynx', 'Raven', 'Otter', 'Badger', 'Heron', 'Mantis', 'Ferret', 'Crane', 'Marmot', 'Magpie'];
    const DOMAIN = ['Time', 'Markets', 'Odds', 'Chaos', 'Tomorrow', 'Trends', 'Fortune', 'Signals', 'Probability', 'the Crowd', 'Tides', 'Futures'];
    const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];
    const buildName = () => {
      const n = Math.floor(Math.random() * 3);
      if (n === 0) return `${pick(ARCH)} of ${pick(DOMAIN)}`;        // Oracle of Time
      if (n === 1) return `${pick(ADJ)} ${pick(CRIT)}`;             // Patient Slug
      return `${pick(ADJ)} ${pick(ARCH)}`;                          // Cosmic Oracle
    };
    const generateNickname = async () => {
      for (let i = 0; i < 8; i++) {
        const cand = `${buildName()} ${Math.floor(Math.random() * 899) + 100}`;
        const r = await checkUnique({ nickname: cand });
        if (!r || !r.nickname_taken) return cand;
      }
      return `${buildName()} ${Math.floor(Math.random() * 9000) + 1000}`;
    };

    // ---- Live validation helpers ----
    const emailValid = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

    const setStatus = (statusEl, inputEl, kind, msg) => {
      inputEl.classList.remove('is-valid', 'is-invalid');
      statusEl.classList.remove('ok', 'bad', 'checking', 'hidden');
      if (kind === 'clear') { statusEl.classList.add('hidden'); statusEl.textContent = ''; return; }
      if (kind === 'ok') inputEl.classList.add('is-valid');
      if (kind === 'bad') inputEl.classList.add('is-invalid');
      statusEl.classList.add(kind);
      statusEl.textContent = msg;
    };

    const debounce = (fn, ms = 400) => {
      let id; return (...a) => { clearTimeout(id); id = setTimeout(() => fn(...a), ms); };
    };

    const checkEmail = async () => {
      const v = emailEl.value.trim();
      if (!v) return setStatus(statusEmail, emailEl, 'clear');
      if (!emailValid(v)) return setStatus(statusEmail, emailEl, 'bad', ERR.email);
      setStatus(statusEmail, emailEl, 'checking', STATUS.checking);
      const result = await checkUnique({ email: v });
      if (emailEl.value.trim() !== v) return;
      if (result && result.email_taken) setStatus(statusEmail, emailEl, 'bad', ERR.emailTaken);
      else setStatus(statusEmail, emailEl, 'ok', STATUS.emailOk);
    };

    const checkNick = async () => {
      const v = nickEl.value.trim();
      if (!v) return setStatus(statusNick, nickEl, 'clear'); // blank → auto-generated on submit
      setStatus(statusNick, nickEl, 'checking', STATUS.checking);
      const result = await checkUnique({ nickname: v });
      if (nickEl.value.trim() !== v) return;
      if (result && result.nickname_taken) setStatus(statusNick, nickEl, 'bad', ERR.nicknameTaken);
      else setStatus(statusNick, nickEl, 'ok', STATUS.nickOk);
    };

    emailEl.addEventListener('input', debounce(checkEmail));
    nickEl.addEventListener('input', debounce(checkNick));

    // Fit each avatar thumbnail to its real content so they're all the same
    // size. getBBox() can report 0 (or throw) if it runs before the freshly
    // un-hidden modal has laid out — which happens inconsistently across
    // browsers — so we normalize each SVG independently and retry on later
    // frames for any that weren't ready yet, instead of giving up wholesale.
    let avatarsNormalized = false;
    let normalizeTries = 0;
    const normalizeAvatars = () => {
      if (avatarsNormalized) return;
      const svgs = Array.from(overlay.querySelectorAll('[data-avatar-opt] svg'));
      if (!svgs.length) return;
      let allOk = true;
      svgs.forEach((svg) => {
        if (svg.dataset.normalized === 'true') return;
        let bb = null;
        try { bb = svg.getBBox(); } catch { allOk = false; return; }
        if (!bb || !bb.width || !bb.height) { allOk = false; return; }
        const pad = 4;
        svg.setAttribute('viewBox', `${(bb.x - pad).toFixed(1)} ${(bb.y - pad).toFixed(1)} ${(bb.width + pad * 2).toFixed(1)} ${(bb.height + pad * 2).toFixed(1)}`);
        svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
        svg.dataset.normalized = 'true';
      });
      avatarsNormalized = allOk;
      // Retry on the next frame until every avatar is framed (capped so a
      // genuinely zero-size SVG can't spin forever).
      if (!allOk && normalizeTries++ < 20) requestAnimationFrame(normalizeAvatars);
    };

    // ---- Open / close ----
    const open = () => {
      lastFocused = document.activeElement;
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        overlay.classList.add('is-open');
        normalizeAvatars();
        (refEl?.value ? emailEl : emailEl)?.focus();
      });
    };
    const close = () => {
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(() => { overlay.hidden = true; }, 220);
      lastFocused?.focus?.();
    };

    document.addEventListener('click', (e) => {
      const trigger = e.target?.closest?.('[data-open-waitlist]');
      if (trigger) { e.preventDefault(); open(); }
    });
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    overlay.querySelectorAll('[data-wl-close]').forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !overlay.hidden) close(); });

    const showError = (msg) => { if (errEl) { errEl.textContent = msg; errEl.classList.remove('hidden'); } };
    const clearError = () => errEl?.classList.add('hidden');

    const submitToApi = async (data) => {
      const res = await fetch(`${CFG.apiBase}/api/waitlist/signup`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      let body = null;
      try { body = await res.json(); } catch {}
      if (!res.ok) {
        const code = typeof body?.detail === 'string' ? body.detail : `http_${res.status}`;
        const err = new Error(code);
        err.code = code;
        err.status = res.status;
        throw err;
      }
      return body; // { nickname, avatar }
    };

    // ---- Referral link + success view ----
    // The backend is the source of truth for the referral link. We display
    // whatever it returns (`referral_link`), falling back to a code- or
    // nickname-based URL only until the backend ships those fields.
    const referralLink = (resp, nick) => {
      if (resp && resp.referral_link) return resp.referral_link;
      const refKey = (resp && resp.referral_code) || nick;
      return `${location.origin}/en?ref=${encodeURIComponent(refKey)}`;
    };
    const showSuccess = (nick, resp) => {
      if (handleEl) handleEl.textContent = nick;
      const link = referralLink(resp, nick);
      if (linkEl) linkEl.value = link;
      formView?.setAttribute('hidden', '');
      successEl?.removeAttribute('hidden');
      showPosition(resp);
    };

    // ---- Waitlist position ----
    // A fresh signup has no referrals yet, so they sit last on the leaderboard
    // — which makes the post-signup total their position. Prefer a `position`
    // straight from the signup response if the backend ever starts sending one,
    // otherwise derive it from the live count. Silent no-op on failure: the
    // generic "share it" copy stays and the position card never appears.
    const fetchCount = async () => {
      if (!CFG.apiBase) return null;
      try {
        const res = await fetch(`${CFG.apiBase}/api/waitlist/count`, { cache: 'no-store' });
        if (!res.ok) return null;
        const data = await res.json();
        return typeof data?.count === 'number' ? data.count : null;
      } catch {
        return null;
      }
    };
    const showPosition = async (resp) => {
      const pos = typeof resp?.position === 'number' ? resp.position : await fetchCount();
      if (!pos || pos < 1) return;
      const n = pos.toLocaleString(LOCALE);
      if (positionEl) positionEl.textContent = `#${n}`;
      positionCard?.removeAttribute('hidden');
      if (earnEl) earnEl.textContent = POSITION_NOTE.replace('{n}', n);
    };

    copyBtn?.addEventListener('click', async () => {
      const link = linkEl?.value || '';
      try {
        await navigator.clipboard.writeText(link);
      } catch {
        linkEl?.select();
        try { document.execCommand('copy'); } catch {}
      }
      copyBtn.classList.add('is-copied');
      if (copyLabel) copyLabel.textContent = COPIED_LABEL;
      setTimeout(() => {
        copyBtn.classList.remove('is-copied');
        if (copyLabel) copyLabel.textContent = COPY_LABEL;
      }, 1800);
    });

    // ---- Submit ----
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();
      const email = emailEl.value.trim();
      const referred = refEl.value.trim();
      const avatar = avatarEl.value || 'avatar_1';
      let nickname = nickEl.value.trim();

      if (!emailValid(email)) { showError(ERR.email); emailEl.focus(); return; }

      submitBtn.disabled = true;
      const reenable = () => { submitBtn.disabled = false; if (submitLabel) submitLabel.textContent = SUBMIT_LABEL; };

      try {
        // No handle chosen → spin up a unique one before signing up.
        if (!nickname) {
          if (submitLabel) submitLabel.textContent = GENERATING_LABEL;
          nickname = await generateNickname();
        }
        if (submitLabel) submitLabel.textContent = SUBMITTING_LABEL;

        const resp = await submitToApi({
          name: nickname,
          email,
          nickname,
          // `referred_by` is the new backend attribution key (a referral code
          // captured from ?ref=). `referred` is kept for backwards-compat with
          // the current nickname-based backend during the transition.
          referred_by: referred || undefined,
          referred: referred || undefined,
          avatar,
        });
        const finalNick = (resp && resp.nickname) || nickname;

        window.dispatchEvent(new CustomEvent('waitlist:joined'));
        showSuccess(finalNick, resp);
      } catch (err) {
        const code = err?.code;
        if (code === 'email_taken') {
          showError(ERR.emailTaken); setStatus(statusEmail, emailEl, 'bad', ERR.emailTaken); reenable(); emailEl.focus(); return;
        }
        if (code === 'nickname_taken') {
          showError(ERR.nicknameTaken); setStatus(statusNick, nickEl, 'bad', ERR.nicknameTaken); reenable(); nickEl.focus(); return;
        }
        showError(ERR.generic); reenable(); return;
      }
    });

    // ---- Referral deep-link: ?ref=<nickname> opens the modal pre-filled ----
    try {
      const ref = new URLSearchParams(location.search).get('ref');
      if (ref && refEl) {
        refEl.value = ref;
        setStatus(statusNick, nickEl, 'clear');
        open();
      }
    } catch { /* ignore */ }
  }
</script>
