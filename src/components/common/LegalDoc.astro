---
// Styled chrome for a legal/long-form page. Renders an eyebrow + a prose
// container; the page passes the rendered markdown (<Content />) as the slot.
export interface Props {
  eyebrow?: string;
}

const { eyebrow = 'Legal' } = Astro.props;
---

<section class="legal-wrap">
  <div class="legal-inner">
    <span class="eyebrow mb-5">
      <span class="gold-dot"></span>
      <span>{eyebrow}</span>
    </span>

    <article class="legal-prose">
      <slot />
    </article>
  </div>
</section>

<style>
  .legal-wrap {
    padding: 4rem 0 6rem;
  }
  .legal-inner {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  @media (min-width: 768px) {
    .legal-wrap { padding: 5.5rem 0 7rem; }
    .legal-inner { padding: 0 2rem; }
  }

  /* Long-form prose — brand-tuned, dark theme. Targets the rendered markdown. */
  .legal-prose {
    font-family: var(--font-sans);
    color: var(--ink-muted);
    font-size: 0.97rem;
    line-height: 1.7;
  }
  .legal-prose :global(h1) {
    margin: 0.4rem 0 0.5rem;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(2.1rem, 5vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #fff;
  }
  .legal-prose :global(h2) {
    margin: 2.4rem 0 0.7rem;
    font-weight: 500;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .legal-prose :global(h3) {
    margin: 1.6rem 0 0.5rem;
    font-weight: 600;
    font-size: 1.05rem;
    color: #fff;
  }
  .legal-prose :global(p) { margin: 0 0 1rem; }
  .legal-prose :global(a) {
    color: var(--brand-lavender);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose :global(a:hover) { color: #fff; }
  .legal-prose :global(strong) { color: #fff; font-weight: 600; }
  .legal-prose :global(ul),
  .legal-prose :global(ol) { margin: 0 0 1rem; padding-left: 1.3rem; }
  .legal-prose :global(ul) { list-style: disc; }
  .legal-prose :global(ol) { list-style: decimal; }
  .legal-prose :global(li) { margin: 0.3rem 0; }
  .legal-prose :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.75rem 1.1rem;
    border-left: 3px solid var(--prize-gold);
    background: rgba(250, 204, 21, 0.06);
    border-radius: 0.5rem;
  }
  .legal-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.1em 0.35em;
    border-radius: 0.3rem;
    color: #fff;
  }
  .legal-prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin: 2rem 0;
  }
  /* Tables (GFM) — scrollable on small screens. */
  .legal-prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.84rem;
  }
  .legal-prose :global(th),
  .legal-prose :global(td) {
    border: 1px solid var(--hairline-strong);
    padding: 0.55rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }
  .legal-prose :global(th) {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
