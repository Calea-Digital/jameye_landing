---
// Styled chrome for a legal/long-form page: a prose container; the page
// passes the rendered markdown (<Content />) as the slot.
---

<section class="legal-wrap">
  <div class="legal-inner">

    <article class="legal-prose">
      <slot />
    </article>
  </div>
</section>

<style>
  .legal-wrap { padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(4.5rem, 8vw, 7rem); }
  .legal-inner {
    max-width: calc(800px + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* Long-form prose on the light canvas. Targets the rendered markdown. */
  .legal-prose {
    font-family: var(--font-sans);
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.8;
  }
  .legal-prose :global(h1) {
    margin: 0 0 1.75rem;
    font-weight: 600;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
    color: var(--ink);
  }
  .legal-prose :global(h2) {
    margin: 3rem 0 0.9rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hairline);
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--ink);
  }
  .legal-prose :global(h3) {
    margin: 1.9rem 0 0.6rem;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .legal-prose :global(p) { margin: 0 0 1.1rem; }
  .legal-prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--brand-violet);
    text-underline-offset: 3px;
  }
  .legal-prose :global(a:hover) { color: var(--brand-violet); }
  .legal-prose :global(strong) { color: var(--ink); font-weight: 600; }
  .legal-prose :global(ul),
  .legal-prose :global(ol) { margin: 0 0 1.1rem; padding-left: 1.3rem; }
  .legal-prose :global(ul) { list-style: disc; }
  .legal-prose :global(ol) { list-style: decimal; }
  .legal-prose :global(li) { margin: 0.35rem 0; }
  .legal-prose :global(li::marker) { color: var(--brand-orchid); }
  .legal-prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border: 1px solid #e8d9ec;
    border-radius: 1rem;
    background: var(--gradient-panel);
    color: var(--ink-soft);
  }
  .legal-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-deep);
    padding: 0.1em 0.4em;
    border-radius: 0.35rem;
    color: var(--ink);
  }
  .legal-prose :global(hr) { border: 0; border-top: 1px solid var(--hairline); margin: 2.5rem 0; }
  /* Tables (GFM) — scrollable on small screens. */
  .legal-prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.25rem 0 1.75rem;
    font-size: 0.86rem;
  }
  .legal-prose :global(th),
  .legal-prose :global(td) {
    border: 1px solid var(--hairline-strong);
    padding: 0.6rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .legal-prose :global(th) {
    background: var(--bg-deep);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
