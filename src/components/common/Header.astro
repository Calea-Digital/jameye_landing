---
import Logo from '~/components/common/Logo.astro';
import { t, localePath, type Locale } from '~/utils/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const nav = t<{ cta: { primary: string } }>(locale, 'nav');
---

<!-- Minimal sticky glass header for the sub-pages (legal, about, leaderboard…):
     just the wordmark linking home and the waitlist CTA. The old section nav
     (How it works / Tournaments / …) pointed at anchors that no longer exist on
     the play landing, so it was removed. -->
<header id="header" class="sticky top-0 z-50 w-full glass-header h-16">
  <div class="max-w-[1280px] mx-auto h-full px-5 md:px-8 flex items-center justify-between gap-3 sm:gap-6">
    <a href={localePath(locale, '/')} class="flex items-center shrink-0" aria-label="Jameye home">
      <Logo size="md" />
    </a>

    <button
      type="button"
      class="btn-primary max-sm:px-3 max-sm:text-[0.6rem] max-sm:tracking-[0.06em] shrink-0"
      data-open-waitlist
    >
      {nav.cta.primary}
    </button>
  </div>
</header>

<script>
  const SCROLL_THRESHOLD = 20;
  const header = document.getElementById('header');
  function handleScroll() {
    if (!header) return;
    header.classList.toggle('scroll', window.scrollY > SCROLL_THRESHOLD);
  }
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>
