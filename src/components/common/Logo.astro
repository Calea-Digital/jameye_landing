---
export interface Props {
  class?: string;
  variant?: 'default' | 'forDark';
  size?: 'sm' | 'md' | 'lg';
}

const { class: className = '', size = 'md' } = Astro.props;

// Brand wordmark — JAMEYE® in Archivo Black, tracking-tight, uppercase, white
// (matches the app; see LOGO.md). Font loaded via the Layout's Google Fonts link.
// md matches the app's top-bar size (text-2xl = 24px).
const sizeMap: Record<'sm' | 'md' | 'lg', string> = {
  sm: 'text-[18px]',
  md: 'text-[24px]',
  lg: 'text-[30px]',
};
---

<span
  class:list={['jameye-wordmark', sizeMap[size], className]}
  aria-label="Jameye"
>
  JAMEYE<sup class="reg">®</sup>
</span>
