---
import { Icon } from 'astro-icon/components';
import { t, type Locale } from '~/utils/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const c = t<{
  title: string;
  body: string;
  policyText: string;
  policyHref: string;
  acceptAll: string;
  rejectAll: string;
  customize: string;
  save: string;
  close: string;
  categories: {
    necessary: { name: string; desc: string; always: string };
    analytics: { name: string; desc: string };
    marketing: { name: string; desc: string };
  };
}>(locale, 'cookies');
---

<!--
  Cookie consent banner. Hidden by default (the inline consent bootstrap in
  Layout.astro reveals it on first visit, when no `jameye_consent` cookie
  exists). Accept/Reject/Save write the cookie and update Google Consent
  Mode v2 so future GA4 / Google Ads / social pixel tags fire only with
  consent. See docs/data-and-cookies-inventory.md §9.5.
-->
<div class="cc-banner" data-cookie-banner role="dialog" aria-modal="false" aria-labelledby="cc-title" aria-describedby="cc-body" hidden>
  <div class="cc-card">
    <div class="cc-inner">
      <div class="cc-copy">
        <p id="cc-title" class="cc-title">{c.title}</p>
        <p id="cc-body" class="cc-body">
          {c.body}
          <a href={c.policyHref} class="cc-link">{c.policyText}</a>
        </p>
      </div>

      <div class="cc-actions">
        <button type="button" class="cc-btn cc-btn--ghost" data-cc-customize aria-expanded="false">
          {c.customize}
        </button>
        <button type="button" class="cc-btn cc-btn--secondary" data-cc-reject>
          {c.rejectAll}
        </button>
        <button type="button" class="cc-btn cc-btn--primary" data-cc-accept>
          {c.acceptAll}
          <Icon name="tabler:check" class="w-3.5 h-3.5" />
        </button>
      </div>
    </div>

    <!-- Customize panel (per-category toggles) -->
    <div class="cc-prefs" data-cc-prefs hidden>
      <div class="cc-prefs-grid">
        <div class="cc-cat">
          <div class="cc-cat-head">
            <span class="cc-cat-name">{c.categories.necessary.name}</span>
            <span class="cc-cat-locked">{c.categories.necessary.always}</span>
          </div>
          <p class="cc-cat-desc">{c.categories.necessary.desc}</p>
        </div>

        <label class="cc-cat">
          <div class="cc-cat-head">
            <span class="cc-cat-name">{c.categories.analytics.name}</span>
            <input type="checkbox" class="cc-switch" data-cc-toggle="analytics" />
          </div>
          <p class="cc-cat-desc">{c.categories.analytics.desc}</p>
        </label>

        <label class="cc-cat">
          <div class="cc-cat-head">
            <span class="cc-cat-name">{c.categories.marketing.name}</span>
            <input type="checkbox" class="cc-switch" data-cc-toggle="marketing" />
          </div>
          <p class="cc-cat-desc">{c.categories.marketing.desc}</p>
        </label>
      </div>
      <button type="button" class="cc-btn cc-btn--primary cc-save" data-cc-save>{c.save}</button>
    </div>
  </div>
</div>

<style>
  /* Floating light card, inset from the viewport edges. */
  .cc-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    padding: 0 var(--gutter) max(1rem, env(safe-area-inset-bottom));
    pointer-events: none;
    transform: translateY(115%);
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cc-banner.is-open { transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .cc-banner { transition: none; }
  }

  .cc-card {
    pointer-events: auto;
    max-width: var(--container);
    margin: 0 auto;
    padding: 1.35rem 1.5rem;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid var(--hairline);
    border-radius: 1.5rem;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: var(--shadow-float);
  }

  .cc-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem 2rem;
    flex-wrap: wrap;
  }
  .cc-copy { flex: 1 1 24rem; min-width: 0; }
  .cc-title { margin: 0 0 0.35rem; font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
  .cc-body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }
  .cc-link {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .cc-link:hover { color: var(--brand-violet); }

  .cc-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }

  .cc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.3rem;
    border-radius: 9999px;
    border: 1px solid transparent;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color 150ms ease, background 150ms ease, color 150ms ease;
  }
  .cc-btn--primary { color: #fff; background: var(--ink); }
  .cc-btn--primary:hover { background: var(--ink-soft); }
  .cc-btn--secondary { color: var(--ink); background: #fff; border-color: var(--hairline-strong); }
  .cc-btn--secondary:hover { background: var(--bg-deep); border-color: var(--ink-ghost); }
  .cc-btn--ghost { color: var(--ink-muted); background: transparent; }
  .cc-btn--ghost:hover { color: var(--ink); }

  /* ---------- Customize panel ---------- */
  .cc-prefs {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline);
  }
  .cc-prefs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .cc-cat {
    display: block;
    padding: 0.9rem 1rem;
    background: var(--bg-deep);
    border: 1px solid var(--hairline);
    border-radius: 1rem;
  }
  label.cc-cat { cursor: pointer; }
  .cc-cat-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .cc-cat-name { font-size: 0.88rem; font-weight: 600; color: var(--ink); }
  .cc-cat-locked {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-violet);
  }
  .cc-cat-desc { margin: 0.4rem 0 0; font-size: 0.8rem; line-height: 1.5; color: var(--ink-muted); }
  .cc-save { margin-top: 1rem; }

  /* Toggle switch (native checkbox restyled) */
  .cc-switch {
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    width: 2.4rem;
    height: 1.35rem;
    flex: 0 0 auto;
    border-radius: 9999px;
    background: var(--ink-ghost);
    cursor: pointer;
    transition: background 160ms ease;
  }
  .cc-switch::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 0.95rem;
    height: 0.95rem;
    transform: translateY(-50%);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgba(35, 11, 49, 0.2);
    transition: transform 160ms ease;
  }
  .cc-switch:checked { background: var(--brand-violet); }
  .cc-switch:checked::after { transform: translateY(-50%) translateX(1.05rem); }
  .cc-switch:focus-visible { outline: 2px solid var(--brand-violet); outline-offset: 2px; }

  @media (max-width: 720px) {
    .cc-card { padding: 1.15rem; }
    .cc-actions { width: 100%; }
    .cc-actions .cc-btn { flex: 1 1 auto; }
    .cc-prefs-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  (() => {
    const COOKIE_NAME = 'jameye_consent';
    const VERSION = 1;
    const MAX_AGE = 60 * 60 * 24 * 180; // 180 days, in seconds

    const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
    if (!banner) return;

    const prefs = banner.querySelector<HTMLElement>('[data-cc-prefs]');
    const customizeBtn = banner.querySelector<HTMLButtonElement>('[data-cc-customize]');
    const toggles = Array.from(
      banner.querySelectorAll<HTMLInputElement>('[data-cc-toggle]')
    );

    type Consent = { analytics: boolean; marketing: boolean };

    const parse = (raw: string | null): (Consent & { v: number }) | null => {
      if (!raw) return null;
      try {
        return JSON.parse(raw);
      } catch {
        return null;
      }
    };

    // Read the stored choice from the cookie, falling back to localStorage.
    // The cookie feeds Google Consent Mode; localStorage is the durable copy,
    // since JS-set cookies are dropped early by some browsers (Safari ITP,
    // strict privacy modes) — which is what made the banner reappear on every
    // refresh.
    const readCookie = (): (Consent & { v: number }) | null => {
      const match = document.cookie
        .split('; ')
        .find((row) => row.startsWith(COOKIE_NAME + '='));
      const fromCookie = match
        ? parse(decodeURIComponent(match.split('=').slice(1).join('=')))
        : null;
      if (fromCookie) return fromCookie;
      try {
        return parse(localStorage.getItem(COOKIE_NAME));
      } catch {
        return null;
      }
    };

    const writeCookie = (consent: Consent) => {
      const payload = JSON.stringify({
        v: VERSION,
        necessary: true,
        analytics: consent.analytics,
        marketing: consent.marketing,
        ts: Date.now(),
      });
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie =
        `${COOKIE_NAME}=${encodeURIComponent(payload)}; Max-Age=${MAX_AGE}; Path=/; SameSite=Lax${secure}`;
      // Durable mirror so the choice survives even if the cookie is purged.
      try { localStorage.setItem(COOKIE_NAME, payload); } catch { /* storage blocked */ }
    };

    // Push consent state into Google Consent Mode v2. `gtag` is defined by the
    // bootstrap in Layout.astro; guarded so this is a no-op until tags exist.
    const applyConsent = (consent: Consent) => {
      const gtag = (window as any).gtag;
      if (typeof gtag === 'function') {
        gtag('consent', 'update', {
          analytics_storage: consent.analytics ? 'granted' : 'denied',
          ad_storage: consent.marketing ? 'granted' : 'denied',
          ad_user_data: consent.marketing ? 'granted' : 'denied',
          ad_personalization: consent.marketing ? 'granted' : 'denied',
        });
      }
      // Let any other script react (e.g. lazily inject pixels post-consent).
      window.dispatchEvent(new CustomEvent('cookie-consent', { detail: consent }));
    };

    const openBanner = () => {
      banner.hidden = false;
      requestAnimationFrame(() => banner.classList.add('is-open'));
    };
    const closeBanner = () => {
      banner.classList.remove('is-open');
      setTimeout(() => { banner.hidden = true; }, 340);
    };

    const finish = (consent: Consent) => {
      writeCookie(consent);
      applyConsent(consent);
      closeBanner();
    };

    // ---- Wire up controls ----
    banner.querySelector('[data-cc-accept]')?.addEventListener('click', () =>
      finish({ analytics: true, marketing: true })
    );
    banner.querySelector('[data-cc-reject]')?.addEventListener('click', () =>
      finish({ analytics: false, marketing: false })
    );
    banner.querySelector('[data-cc-save]')?.addEventListener('click', () =>
      finish({
        analytics: !!toggles.find((t) => t.dataset.ccToggle === 'analytics')?.checked,
        marketing: !!toggles.find((t) => t.dataset.ccToggle === 'marketing')?.checked,
      })
    );

    customizeBtn?.addEventListener('click', () => {
      if (!prefs) return;
      const open = prefs.hidden;
      prefs.hidden = !open;
      customizeBtn.setAttribute('aria-expanded', String(open));
    });

    // ---- Reopen hook: any [data-open-cookie-settings] element (e.g. footer
    //      "Cookie settings" link) reopens the banner with current choices. ----
    const reopen = () => {
      const saved = readCookie();
      toggles.forEach((t) => {
        const key = t.dataset.ccToggle as keyof Consent;
        t.checked = saved ? !!saved[key] : false;
      });
      if (prefs) prefs.hidden = false;
      customizeBtn?.setAttribute('aria-expanded', 'true');
      openBanner();
    };
    (window as any).openCookieSettings = reopen;
    document.addEventListener('click', (e) => {
      if ((e.target as Element)?.closest?.('[data-open-cookie-settings]')) {
        e.preventDefault();
        reopen();
      }
    });

    // ---- First visit only: with no stored choice, show the banner. On
    //      return visits we re-apply the saved choice — and rewrite the cookie
    //      from the durable copy if it was purged — so it never reappears. ----
    const saved = readCookie();
    if (!saved) {
      openBanner();
    } else {
      const consent = { analytics: !!saved.analytics, marketing: !!saved.marketing };
      applyConsent(consent);
      writeCookie(consent);
    }
  })();
</script>
