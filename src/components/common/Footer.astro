---
// Site footer shared by every page: wordmark + signature, the legal links and
// a two-line tagline.
import Logo from '~/components/common/Logo.astro';
import { t, localePath, type Locale } from '~/utils/i18n';
import { CONTACT_EMAIL } from '~/config';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const data = t<{
  signature: string;
  links: { text: string; href: string }[];
  contact: string;
  tagline: string[];
}>(locale, 'footer');
---

<footer class="jm-footer">
  <div class="jm-container">
    <div class="jm-footer__inner">
    <div class="jm-footer__brand">
      <a href={localePath(locale, '/')} aria-label="Jameye home">
        <Logo size="md" />
      </a>
      <p class="jm-footer__signature">{data.signature}</p>
    </div>

    <nav class="jm-footer__links" aria-label="Footer">
      {data.links.map((link) => <a href={link.href}>{link.text}</a>)}
      <a href={`mailto:${CONTACT_EMAIL}`}>{data.contact}</a>
    </nav>

    <p class="jm-footer__tagline">
      {data.tagline.map((line) => <span>{line}</span>)}
    </p>
    </div>
  </div>
</footer>
