---
// Creator rail — an infinite marquee of character cards. The card list is
// rendered twice inside the track so the -50% slide loops seamlessly (the
// second copy is decorative: aria-hidden, and dropped under reduced motion,
// where the rail turns into a finger-scrollable strip instead). A real cursor
// pauses it on hover; touch never does, since :hover sticks after a tap. The
// faces are Jameye characters, not portraits.
import { toneColor } from './tones';
import type { ForecastContent } from './types';

export interface Props {
  creators: ForecastContent['creators'];
}

const { creators } = Astro.props;
---

<section class="fx-section" id="creators" style="display:flex;flex-direction:column;gap:28px;">
  <div class="fx-shell fx-rail-head">
    <div style="display:flex;flex-direction:column;gap:10px;">
      <h2 class="fx-h2">
        <span class="fx-grad-text">{creators.titleAccent}</span> {creators.titleRest}
      </h2>
      <span style="font-size:14px;color:var(--fx-ink-60);max-width:560px;line-height:1.5;">{creators.lead}</span>
    </div>
    <div class="fx-rail-head__cta">
      <button type="button" class="fx-btn fx-btn--ghost fx-btn--sm" data-open-waitlist>{creators.cta}</button>
    </div>
  </div>

  <div class="fx-rail">
    <div class="fx-rail__track">
      {
        [0, 1].map((copy) =>
          creators.cards.map((card) => (
            <article
              class:list={['fx-creator', 'fx-creator--avatar', card.founding && 'fx-creator--founding', copy === 1 && 'fx-creator--dup']}
              aria-hidden={copy === 1 ? 'true' : undefined}
            >
              <img src={card.image} alt="" loading="lazy" />
              <span class="fx-creator__scrim"></span>
              {card.founding && <span class="fx-creator__flag">FOUNDING CREATOR</span>}
              <span class="fx-creator__rank" style={`color:${toneColor(card.tone)};`}>{card.rank.toUpperCase()}</span>
              <span class="fx-creator__name">{card.name}</span>
              <span class="fx-creator__stats">{card.stats}</span>
              <span class="fx-call">
                <span class="fx-call__q">{card.call}</span>
                <span class:list={['fx-call__odds', !card.down && 'fx-call__odds--yes']}>{card.odds}</span>
              </span>
            </article>
          ))
        )
      }
    </div>
  </div>
</section>
