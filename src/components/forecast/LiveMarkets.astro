---
// Live markets grid — one card per open market, colour-keyed to its vertical.
//
// The cards are curated in forecast.json: a deliberate spread across sports
// and beyond (El Clásico, F1, the NBA Finals, the Masters, Bitcoin, the Fed's
// December decision) with real photography, sourced like the hero cards (Unsplash).
// They are showcase markets, not a live feed — the Polymarket fetch this
// section used to make lives on in utils/polymarket.ts for HowItWorks.
import { toneColor } from './tones';
import type { ForecastContent, MarketCard } from './types';

export interface Props {
  markets: ForecastContent['markets'];
}

const { markets } = Astro.props;
const cards: MarketCard[] = markets.cards;

// The legend mirrors whatever is actually on the grid.
const legend = [...new Map(cards.map((c) => [c.vertical, { label: c.vertical, tone: c.tone }])).values()];
---

<section class="fx-markets" id="markets">
  <div class="fx-shell fx-markets__inner">
    <div class="fx-markets__head">
      <div style="display:flex;flex-direction:column;gap:12px;">
        <span class="fx-eyebrow">{markets.eyebrow}</span>
        <h2 class="fx-h2">
          {markets.titleLead}
          <span class="fx-grad-text">{markets.titleAccent}</span>
        </h2>
        <p class="fx-lead">{markets.lead}</p>
      </div>

      <div class="fx-legend">
        {
          legend.map((item) => (
            <span class="fx-legend__item">
              <span
                class="fx-dot"
                style={`background:${toneColor(item.tone)};box-shadow:0 0 8px ${toneColor(item.tone)};`}
              ></span>
              {item.label}
            </span>
          ))
        }
      </div>
    </div>

    <div class="fx-market-grid">
      {
        cards.map((card) => (
          <button type="button" class="fx-market" data-open-waitlist>
            <span class="fx-market__shot">
              <img src={card.image} alt="" loading="lazy" style={card.focus ? `object-position:${card.focus};` : undefined} />
            </span>
            <span class="fx-market__body">
              <span class="fx-market__top">
                <span class="fx-market__vertical" style={`color:${toneColor(card.tone)};`}>
                  <span class="fx-dot" style={`background:${toneColor(card.tone)};`}></span>
                  {card.vertical.toUpperCase()}
                </span>
                <span class="fx-market__in">{card.in}</span>
              </span>
              <span class="fx-market__q">{card.question}</span>
              <span class="fx-market__odds">
                <span class="fx-meter"><span style={`width:${card.pct}%;`}></span></span>
                <span class="fx-market__pct">{card.pct}% <small>{card.side}</small></span>
              </span>
            </span>
          </button>
        ))
      }
    </div>

    <button type="button" class="fx-btn fx-btn--ghost fx-btn--sm" style="align-self:center;" data-open-waitlist>
      {markets.cta}
    </button>
  </div>
</section>
