---
// "Forecast the world. With them." — the landing page, top to bottom.
// Content (copy, imagery, market data) lives in src/lang/<locale>/forecast.json;
// the look lives in src/styles/forecast.css.
import { t, type Locale } from '~/utils/i18n';
import type { ForecastContent } from './types';

import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Ticker from './Ticker.astro';
import Play from './Play.astro';
import Creators from './Creators.astro';
import LiveMarkets from './LiveMarkets.astro';
import Fiq from './Fiq.astro';
import SkillNotLuck from './SkillNotLuck.astro';
import Waitlist from './Waitlist.astro';
import SiteFooter from './SiteFooter.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t<ForecastContent>(locale, 'forecast');
---

<div class="fx-page">
  <Nav nav={c.nav} />
  <Hero hero={c.hero} />
  <Ticker items={c.ticker} />
  <main class="fx-main">
    <Play play={c.play} />
    <Creators creators={c.creators} />
    <LiveMarkets markets={c.markets} />
    <Fiq fiq={c.fiq} />
    <SkillNotLuck skill={c.skill} />
    <Waitlist waitlist={c.waitlist} />
  </main>
  <SiteFooter footer={c.footer} />
</div>
