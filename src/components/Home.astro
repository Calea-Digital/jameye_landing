---
// Shared homepage. Rendered both at the locale root (/en) and at the bare site
// root (/) so social/SEO crawlers that hit https://jameye.com/ get the real
// page (hero + Open Graph tags) instead of a "Redirecting to /en" stub. The
// `canonicalUrl` is pinned to the /en core for both so search engines
// consolidate on a single URL (no duplicate-content split).
//
// "Forecast what's next. Together." — the creator-driven social forecasting
// landing. Copy lives in src/lang/<locale>/home.json, the component layer in
// src/styles/landing.css. Every call to action opens the beta (BETA_URL).
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/common/Header.astro';
import Footer from '~/components/common/Footer.astro';
import Hero from '~/components/home/Hero.astro';
import Community from '~/components/home/Community.astro';
import Explore from '~/components/home/Explore.astro';
import HowItWorks from '~/components/home/HowItWorks.astro';
import ClosingCta from '~/components/home/ClosingCta.astro';
import type { HomeContent } from '~/components/home/types';
import { t, type Locale } from '~/utils/i18n';

export interface Props {
  locale?: Locale;
  /** Canonical URL override — both / and /en pin this to the /en core. */
  canonicalUrl?: string;
}

const { locale = 'en', canonicalUrl } = Astro.props;
const meta = { ...t<{ title: string; description: string }>(locale, 'meta'), canonicalUrl };
const c = t<HomeContent>(locale, 'home');
---

<Layout metadata={meta} locale={locale}>
  <Header locale={locale} onHome />
  <main id="top">
    <Hero hero={c.hero} />
    <Community community={c.community} />
    <Explore explore={c.explore} />
    <HowItWorks how={c.how} />
    <ClosingCta closing={c.closing} />
  </main>
  <Footer locale={locale} />
</Layout>
