---
// Shared homepage. Rendered both at the locale root (/en) and at the bare site
// root (/) so social/SEO crawlers that hit https://jameye.com/ get the real
// page (hero + Open Graph tags) instead of a "Redirecting to /en" stub. The
// `canonicalUrl` is pinned to the /en core for both so search engines
// consolidate on a single URL (no duplicate-content split).
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/common/Header.astro';
import Footer from '~/components/common/Footer.astro';
import Hero from '~/components/sections/Hero.astro';
import Roster from '~/components/sections/Roster.astro';
import BattleUniversities from '~/components/sections/BattleUniversities.astro';
import VideoShowcase from '~/components/sections/VideoShowcase.astro';
import HowItWorks from '~/components/sections/HowItWorks.astro';
import Calibration from '~/components/sections/Calibration.astro';
import TournamentFormats from '~/components/sections/TournamentFormats.astro';
import WinCash from '~/components/sections/WinCash.astro';
// import Tournaments from '~/components/sections/Tournaments.astro'; // Temporarily hidden — superseded by WinCash; keep for potential reuse
import CtaFinal from '~/components/sections/CtaFinal.astro';
import WaitlistModal from '~/components/common/WaitlistModal.astro';
import { t, type Locale } from '~/utils/i18n';

export interface Props {
  locale?: Locale;
  /** Canonical URL override — both / and /en pin this to the /en core. */
  canonicalUrl?: string;
}

const { locale = 'en', canonicalUrl } = Astro.props;
const meta = { ...t<{ title: string; description: string }>(locale, 'meta'), canonicalUrl };
---

<Layout metadata={meta} locale={locale}>
  <Header locale={locale} />
  <main id="top">
    <Hero locale={locale} />
    <VideoShowcase locale={locale} />
    <HowItWorks locale={locale} />
    <Calibration locale={locale} />
    <TournamentFormats locale={locale} />
    <WinCash locale={locale} />
    <Roster locale={locale} />
    <BattleUniversities locale={locale} />
    <CtaFinal locale={locale} />
  </main>
  <Footer locale={locale} />
  <WaitlistModal locale={locale} />
</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-scroll]').forEach((el) => observer.observe(el));
</script>
