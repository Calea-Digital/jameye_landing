---
// Shared homepage. Rendered both at the locale root (/en) and at the bare site
// root (/) so social/SEO crawlers that hit https://jameye.com/ get the real
// page (hero + Open Graph tags) instead of a "Redirecting to /en" stub. The
// `canonicalUrl` is pinned to the /en core for both so search engines
// consolidate on a single URL (no duplicate-content split).
//
// The page is the "Forecast the world. With them." design: an aurora-violet
// landing built from src/components/forecast (copy and market data in
// src/lang/<locale>/forecast.json, styling in src/styles/forecast.css). Every
// call to action — nav, hero, market cards, the closing panel — opens the
// shared waitlist modal via [data-open-waitlist].
import Layout from '~/layouts/Layout.astro';
import ForecastLanding from '~/components/forecast/ForecastLanding.astro';
import WaitlistModal from '~/components/common/WaitlistModal.astro';
import { t, type Locale } from '~/utils/i18n';

export interface Props {
  locale?: Locale;
  /** Canonical URL override — both / and /en pin this to the /en core. */
  canonicalUrl?: string;
}

const { locale = 'en', canonicalUrl } = Astro.props;
const meta = { ...t<{ title: string; description: string }>(locale, 'meta'), canonicalUrl };
---

<Layout metadata={meta} locale={locale}>
  <ForecastLanding locale={locale} />
  <WaitlistModal locale={locale} />
</Layout>
