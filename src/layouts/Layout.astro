---
import type { ImageMetadata } from 'astro';

import Favicons from '~/meta/Favicons.astro';
import '~/styles/global.css';
import BasicScripts from '~/components/common/BasicScripts.astro';
import CookieConsent from '~/components/common/CookieConsent.astro';
import { SITE } from '~/config';
import { SEO } from 'astro-seo';

import importImage from '~/utils/importImage';

import type { Locale } from '~/utils/i18n';

export interface Props {
  locale?: Locale;
  metadata?: {
    title?: string;
    useTitleTemplate?: boolean;
    description?: string;
    ogImagePath?: string;
    canonicalUrl?: string;
    pubDatetime?: Date;
    modDatetime?: Date;
    author?: string;
    index?: boolean;
    follow?: boolean;
  };
}

const { metadata, locale = 'en' } = Astro.props;

// Import the ogImage dynamically if it's provided
let ogImage: ImageMetadata | undefined;
if (metadata?.ogImagePath) {
  ogImage = await importImage(metadata?.ogImagePath);
}
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <!-- Common Metadata -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Consent Mode v2 — MUST run before any analytics/ads tag.
         Defaults every non-essential storage type to "denied"; the cookie
         banner (CookieConsent.astro) flips them to "granted" on accept. On
         repeat visits the stored choice is re-applied here so tags fire with
         the right state immediately. See docs/data-and-cookies-inventory.md §9. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });

      // Re-apply a previously saved choice so consent is correct before tags load.
      try {
        var m = document.cookie.split('; ').find(function (r) { return r.indexOf('jameye_consent=') === 0; });
        if (m) {
          var c = JSON.parse(decodeURIComponent(m.split('=').slice(1).join('=')));
          gtag('consent', 'update', {
            analytics_storage: c.analytics ? 'granted' : 'denied',
            ad_storage: c.marketing ? 'granted' : 'denied',
            ad_user_data: c.marketing ? 'granted' : 'denied',
            ad_personalization: c.marketing ? 'granted' : 'denied',
          });
        }
      } catch (e) { /* no stored consent yet */ }
    </script>

    <!-- Favicons -->
    <Favicons />

    <!-- Fonts · Brand book §3.1 — Inter Tight (display @ 300), Space Grotesk (body),
         JetBrains Mono (numerics, eyebrows), Instrument Serif (editorial italic flourish). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter+Tight:wght@200;300;400;500;600;700;800;900&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
    />

    <!-- SEO stuff -->
    <!-- Uses SITE config by default -->
    <SEO
      title={metadata?.title || SITE().title}
      titleTemplate={metadata?.useTitleTemplate ? `%s - ${SITE().title}` : undefined}
      description={metadata?.description || SITE().description}
      canonical={metadata?.canonicalUrl || Astro.url.href}
      noindex={metadata?.index === false}
      nofollow={metadata?.follow === false}
      openGraph={{
        basic: {
          title: metadata?.title || SITE().title,
          type: 'website',
          image: ogImage?.src || SITE().ogImage,
          url: metadata?.canonicalUrl || Astro.url.href,
        },
        optional: {
          locale: SITE().locale,
          siteName: SITE().title,
          description: metadata?.description || SITE().description,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: SITE().twitter.site,
        title: metadata?.title || SITE().title,
        description: metadata?.description || SITE().description,
        image: ogImage?.src || SITE().ogImage,
      }}
    />
  </head>
  <body class="bg-background text-foreground">
    <!-- Brand gradient definitions for icon strokes (.gradient-tile glyphs are
         drawn in these). Hidden; referenced via stroke: url(#jam-grad-*). -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
      <defs>
        <linearGradient id="jam-grad-brand-sweep" gradientUnits="userSpaceOnUse" x1="2" y1="3" x2="22" y2="21">
          <stop offset="0%" stop-color="#2962ff" /><stop offset="55%" stop-color="#7e3bff" /><stop offset="100%" stop-color="#d83bff" />
        </linearGradient>
        <linearGradient id="jam-grad-indigo-violet" gradientUnits="userSpaceOnUse" x1="2" y1="3" x2="22" y2="21">
          <stop offset="0%" stop-color="#5b8dff" /><stop offset="100%" stop-color="#7e3bff" />
        </linearGradient>
        <linearGradient id="jam-grad-violet-magenta" gradientUnits="userSpaceOnUse" x1="2" y1="3" x2="22" y2="21">
          <stop offset="0%" stop-color="#7e3bff" /><stop offset="100%" stop-color="#d83bff" />
        </linearGradient>
        <linearGradient id="jam-grad-magenta-pink" gradientUnits="userSpaceOnUse" x1="2" y1="3" x2="22" y2="21">
          <stop offset="0%" stop-color="#d83bff" /><stop offset="100%" stop-color="#ff3ba8" />
        </linearGradient>
        <linearGradient id="jam-grad-gold-orange" gradientUnits="userSpaceOnUse" x1="2" y1="3" x2="22" y2="21">
          <stop offset="0%" stop-color="#facc15" /><stop offset="100%" stop-color="#fb923c" />
        </linearGradient>
        <linearGradient id="jam-grad-emerald-blue" gradientUnits="userSpaceOnUse" x1="2" y1="3" x2="22" y2="21">
          <stop offset="0%" stop-color="#10b981" /><stop offset="100%" stop-color="#2962ff" />
        </linearGradient>
        <linearGradient id="jam-grad-emerald-teal" gradientUnits="userSpaceOnUse" x1="2" y1="3" x2="22" y2="21">
          <stop offset="0%" stop-color="#10b981" /><stop offset="100%" stop-color="#14b8a6" />
        </linearGradient>
      </defs>
    </svg>
    <slot />
    <CookieConsent locale={locale} />
    <BasicScripts />
  </body>
</html>
