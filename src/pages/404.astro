---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/common/Header.astro';
import Footer from '~/components/common/Footer.astro';
import { type Locale } from '~/utils/i18n';

const locale: Locale = 'en';
---

<Layout
  locale={locale}
  metadata={{
    title: '404 — Not Found',
    description: 'Sorry, the page you are looking for does not exist.',
    index: false,
  }}
>
  <Header locale={locale} />
  <main id="top">
    <section class="nf">
      <div class="nf__inner">
        <p class="jm-eyebrow jm-eyebrow--dot">Error 404</p>
        <h1 class="nf__title">
          <span class="jm-block">This page</span>
          <span class="jm-block jm-gradient-text">isn’t here.</span>
        </h1>
        <p class="nf__sub">The link may be old, or the page has moved. Let’s get you back to the big questions.</p>
        <a href="/en" class="jm-btn jm-btn--dark jm-btn--lg">
          <span>Back to home</span>
          <svg class="jm-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
        </a>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>

<style>
  .nf {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 62vh;
    padding: clamp(4rem, 9vw, 7rem) var(--gutter);
    text-align: center;
    overflow: hidden;
  }
  .nf::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(45% 60% at 50% 70%, rgba(236, 166, 210, 0.28), rgba(166, 140, 242, 0.1) 55%, transparent 80%);
  }
  .nf__inner { display: flex; flex-direction: column; align-items: center; max-width: 36rem; }
  .nf__title {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .nf__sub { margin: 1.75rem 0 2.4rem; font-size: 1.05rem; line-height: 1.7; color: var(--ink-muted); }
</style>
