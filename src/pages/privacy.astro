---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/common/Header.astro';
import Footer from '~/components/common/Footer.astro';
import LegalDoc, { type LegalSection } from '~/components/common/LegalDoc.astro';
import WaitlistModal from '~/components/common/WaitlistModal.astro';
import { t, type Locale } from '~/utils/i18n';

const locale: Locale = 'en';
const L = t<{
  updatedLabel: string;
  updated: string;
  placeholderNote: string;
  manageCookies: string;
  docs: Record<string, { eyebrow: string; title: string; intro: string; sections: LegalSection[] }>;
}>(locale, 'legal');
const doc = L.docs.privacy;
const meta = { title: doc.title, description: doc.intro };
---

<Layout metadata={meta} locale={locale}>
  <Header locale={locale} />
  <main id="top">
    <LegalDoc
      eyebrow={doc.eyebrow}
      title={doc.title}
      intro={doc.intro}
      updatedLabel={L.updatedLabel}
      updated={L.updated}
      placeholderNote={L.placeholderNote}
      sections={doc.sections}
    />
  </main>
  <Footer locale={locale} />
  <WaitlistModal locale={locale} />
</Layout>
