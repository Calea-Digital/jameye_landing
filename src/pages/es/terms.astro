---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/common/Header.astro';
import Footer from '~/components/common/Footer.astro';
import LegalDoc from '~/components/common/LegalDoc.astro';
import WaitlistModal from '~/components/common/WaitlistModal.astro';
import { Content } from '~/legal/terms-of-service.md';
import type { Locale } from '~/utils/i18n';

const locale: Locale = 'es';
const meta = {
  title: 'Términos del servicio',
  description: 'Los términos que rigen el uso del sitio de Jameye.',
};
---

<Layout metadata={meta} locale={locale}>
  <Header locale={locale} />
  <main id="top">
    <LegalDoc>
      <Content />
    </LegalDoc>
  </main>
  <Footer locale={locale} />
  <WaitlistModal locale={locale} />
</Layout>
