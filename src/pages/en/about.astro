---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/common/Header.astro';
import Footer from '~/components/common/Footer.astro';
import { t, localePath, type Locale } from '~/utils/i18n';
import { BETA_URL } from '~/config';

const locale: Locale = 'en';
const home = localePath(locale, '/');

interface TitlePair { lead: string; ital: string }
interface IconLabel { icon: string; label: string }

const data = t<{
  meta: { title: string; description: string };
  hero: { eyebrow: string; title: TitlePair; body: string; credentials: IconLabel[] };
  research: {
    eyebrow: string;
    title: TitlePair;
    body: string[];
    people: string[];
    stat: { value: string; label: string; detail: string };
    source: { lead: string; links: { label: string; href: string }[] };
  };
  edge: { eyebrow: string; lead: string; body: string; pull: string };
  sport: { eyebrow: string; title: TitlePair; body: string; steps: IconLabel[] };
  measure: {
    eyebrow: string;
    title: TitlePair;
    cards: { icon: string; tone: string; n: string; title: string; body: string }[];
    score: { label: string; title: string; body: string; window: string; windowLabel: string };
  };
  fair: { eyebrow: string; lines: string[]; body: string };
  closing: {
    ghostWord: string;
    title: TitlePair;
    body: string;
    cta: { primary: string; secondary: string };
  };
}>(locale, 'about');

const meta = { ...data.meta, ogImagePath: undefined };
---

<Layout metadata={meta} locale={locale}>
  <Header locale={locale} />

  <main id="top" class="about-page">
    <!-- ───────────────────────── Hero / intro ───────────────────────── -->
    <section class="about-hero">
      <div class="jm-container">
        <div class="max-w-[960px]" data-scroll>
          <h1 class="about-display" style="font-size: clamp(2.75rem, 6.4vw, 5.4rem);">
            {data.hero.title.lead}<br />
            <span class="jm-gradient-text">{data.hero.title.ital}</span>
          </h1>
          <p class="about-lead mt-8 max-w-[620px]">
            {data.hero.body}
          </p>

          <ul class="mt-10 flex flex-wrap gap-2.5 justify-center md:justify-start">
            {
              data.hero.credentials.map((c) => (
                <li class="cred-pill">
                  <Icon name={c.icon} class="w-4 h-4" />
                  {c.label}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── The research ───────────────────────── -->
    <section class="about-section">
      <div class="jm-container">
        <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-14 items-start">
          <div data-scroll>
            <h2 class="jm-h2 about-h2" style="font-size: clamp(2.1rem, 4.4vw, 3.5rem);">
              {data.research.title.lead}<br />
              <span class="jm-gradient-text">{data.research.title.ital}</span>
            </h2>
            {
              data.research.body.map((p) => (
                <p class="about-body mt-5 max-w-[560px]">{p}</p>
              ))
            }

            <div class="mt-8 flex flex-wrap gap-2.5 justify-center md:justify-start">
              {
                data.research.people.map((person) => (
                  <span class="person-tag">{person}</span>
                ))
              }
            </div>

            <p class="research-source">
              {data.research.source.lead}{' '}
              {
                data.research.source.links.map((link, i) => (
                  <>
                    {i > 0 && (i === data.research.source.links.length - 1 ? ' and ' : ', ')}
                    <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></>
                ))
              }.
            </p>
          </div>

          <!-- Big stat callout -->
          <aside class="stat-callout" data-scroll>
            <div class="stat-callout__value jm-gradient-text">{data.research.stat.value}</div>
            <div class="stat-callout__label">{data.research.stat.label}</div>
            <p class="stat-callout__detail">{data.research.stat.detail}</p>
            <div class="stat-callout__bars" aria-hidden="true">
              <div class="bar bar--pro"><span style="width:69%"></span><em>Analysts</em></div>
              <div class="bar bar--super"><span style="width:100%"></span><em>Superforecasters</em></div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── It wasn't luck ───────────────────────── -->
    <section class="about-section">
      <div class="jm-container">
        <div class="max-w-[860px] mx-auto text-center" data-scroll>
          <p class="edge-copy">
            <span class="edge-copy__lead">{data.edge.lead}</span> {data.edge.body}
          </p>
          <blockquote class="pull-quote">
            <span class="jm-gradient-text">{data.edge.pull}</span>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── Turned it into a sport ───────────────────────── -->
    <section class="about-section">
      <div class="jm-container">
        <div class="jm-panel sport-panel">
        <div class="max-w-[760px] mx-auto text-center mb-10 md:mb-12" data-scroll>
          <h2 class="jm-h2" style="font-size: clamp(2.25rem, 4.8vw, 3.75rem);">
            {data.sport.title.lead} <span class="jm-gradient-text">{data.sport.title.ital}</span>
          </h2>
          <p class="section-sub mt-6">{data.sport.body}</p>
        </div>

        <ol class="sport-flow" data-scroll>
          {
            data.sport.steps.map((s, i) => (
              <li class="sport-step">
                <span class="gradient-tile" data-tone="brand-sweep">
                  <Icon name={s.icon} class="w-5 h-5" />
                </span>
                <span class="sport-step__label">{s.label}</span>
                {i < data.sport.steps.length - 1 && (
                  <Icon name="tabler:chevron-right" class="sport-step__arrow w-4 h-4" />
                )}
              </li>
            ))
          }
        </ol>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── What we measure ───────────────────────── -->
    <section class="about-section">
      <div class="jm-container">
        <div class="section-head" data-scroll>
          <h2 class="jm-h2" style="font-size: clamp(2.25rem, 4.8vw, 3.75rem);">
            {data.measure.title.lead} <span class="jm-gradient-text">{data.measure.title.ital}</span>
          </h2>
        </div>

        <div class="measure-grid" data-scroll>
          {
            data.measure.cards.map((c) => (
              <article class="measure-card">
                <div class="measure-card__top">
                  <span class="gradient-tile" data-tone={c.tone}>
                    <Icon name={c.icon} class="w-5 h-5" />
                  </span>
                  <span class="measure-card__n jm-num">{c.n}</span>
                </div>
                <h3 class="measure-card__title">{c.title}</h3>
                <p class="measure-card__body">{c.body}</p>
              </article>
            ))
          }
        </div>

        <!-- Follow-the-outcome panel (the gauge only renders when a window value is set) -->
        <div class:list={['score-panel', !data.measure.score.window && 'score-panel--copy-only']} data-scroll>
          <div class="score-panel__copy">
            <span class="meta-label">{data.measure.score.label}</span>
            <h3 class="score-panel__title">{data.measure.score.title}</h3>
            <p class="score-panel__body">{data.measure.score.body}</p>
          </div>
          {data.measure.score.window && (
            <div class="score-panel__gauge" aria-hidden="true">
              <span class="score-panel__window meta-label">{data.measure.score.windowLabel}</span>
              <span class="score-panel__num jm-gradient-text">{data.measure.score.window}</span>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ───────────────────────── What we believe ───────────────────────── -->
    <section class="about-section about-section--wide">
      <div class="jm-container text-center" data-scroll>
        <h2 class="about-display" style="font-size: clamp(2.5rem, 6.4vw, 5rem);">
          {data.fair.lines.map((line) => (<span class="block">{line}</span>))}
        </h2>
        <p class="about-lead mt-8 max-w-[640px] mx-auto">
          {data.fair.body}
        </p>
      </div>
    </section>

    <!-- ───────────────────────── Closing CTA ───────────────────────── -->
    <section class="about-closing relative text-center overflow-hidden">
      <span
        aria-hidden="true"
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none select-none z-0"
        style="font-size: clamp(14rem, 34vw, 32rem); line-height: 1; color: rgba(35, 11, 49, 0.035); letter-spacing: -0.04em;"
      >
        {data.closing.ghostWord}
      </span>

      <div class="relative z-10 max-w-[880px] mx-auto px-5 md:px-8 w-full" data-scroll>
        <h2 class="about-display" style="font-size: clamp(2.75rem, 6.4vw, 5.25rem);">
          {data.closing.title.lead} <span class="jm-gradient-text">{data.closing.title.ital}</span>
        </h2>
        <p class="about-lead mt-7 max-w-[520px] mx-auto">
          {data.closing.body}
        </p>
        <div class="mt-11 flex justify-center items-center gap-4 flex-wrap">
          <a href={BETA_URL} class="jm-btn jm-btn--gradient jm-btn--lg" rel="noopener">
            <span>{data.closing.cta.primary}</span>
            <svg class="jm-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
          </a>
          <a href={`${home}#how-it-works`} class="cta-ghost">{data.closing.cta.secondary}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Layout>

<style>
  /* Light "creator-driven social forecasting" skin. Sections flow naturally
     with generous vertical padding; type, cards and pills follow the
     homepage vocabulary in src/styles/landing.css (.jm-*). */

  /* ---- Rhythm ---- */
  .about-hero { padding-block: clamp(3rem, 7vw, 6.5rem) clamp(2.5rem, 5vw, 4rem); }
  .about-section { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .about-section--wide { padding-block: clamp(4rem, 9vw, 7.5rem); }
  .about-closing { padding-block: clamp(5rem, 10vw, 8.5rem); }
  /* Soft blush glow under the closing CTA, as on the homepage. */
  .about-closing::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(48% 62% at 50% 92%, rgba(236, 166, 210, 0.3), rgba(166, 140, 242, 0.12) 50%, transparent 78%);
    pointer-events: none;
  }

  /* ---- Type ---- */
  .about-display {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.05em;
    color: var(--ink);
  }
  .about-h2 { text-align: left; }
  .about-lead {
    font-size: clamp(1.02rem, 1.3vw, 1.2rem);
    line-height: 1.65;
    color: var(--ink-muted);
  }
  .about-body {
    font-size: clamp(0.98rem, 1.15vw, 1.08rem);
    line-height: 1.75;
    color: var(--ink-muted);
  }

  /* ---- Credential pills (hero) ---- */
  .cred-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.62rem 1.15rem;
    border-radius: 9999px;
    border: 1px solid var(--hairline-strong);
    background: var(--bg-card);
    box-shadow: var(--shadow-xs);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .cred-pill :global(svg) { color: var(--brand-violet); }

  /* ---- Research people tags ---- */
  .person-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.95rem;
    border-radius: 9999px;
    border: 1px dashed var(--hairline-strong);
    font-family: var(--font-body);
    font-size: 0.84rem;
    color: var(--ink-muted);
  }

  /* ---- Research source attribution ---- */
  .research-source {
    margin-top: 1.5rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 560px;
  }
  .research-source a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--hairline-strong);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .research-source a:hover {
    color: var(--brand-violet);
    text-decoration-color: var(--brand-violet);
  }

  /* ---- Stat callout ---- */
  .stat-callout {
    background: var(--bg-card);
    border: 1px solid var(--hairline);
    border-radius: 1.6rem;
    box-shadow: var(--shadow-card);
    padding: clamp(1.75rem, 3vw, 2.5rem);
  }
  .stat-callout__value {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(3.5rem, 8vw, 5rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .stat-callout__label {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
    margin-top: 0.9rem;
  }
  .stat-callout__detail {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-muted);
    margin-top: 0.6rem;
  }
  .stat-callout__bars {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .stat-callout__bars .bar {
    position: relative;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--bg-deep);
    overflow: hidden;
  }
  .stat-callout__bars .bar span {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 999px;
    display: block;
  }
  .stat-callout__bars .bar--pro span { background: var(--hairline-strong); }
  .stat-callout__bars .bar--super span { background-image: var(--gradient-cta); }
  .stat-callout__bars .bar em {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    z-index: 1;
  }

  /* ---- "It wasn't luck" ---- */
  .edge-copy {
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--ink-muted);
  }
  .edge-copy__lead { color: var(--ink); font-weight: 600; }

  /* ---- Pull quote ---- */
  .pull-quote {
    margin: 2.5rem auto 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  /* ---- Sport flow ---- */
  .sport-panel { text-align: center; }
  .sport-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.9rem 0.6rem;
    max-width: 60rem;
    margin: 0 auto;
  }
  /* Each step is a white pill (icon tile + label); the chevron sits in the
     gap to its right. */
  .sport-step {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 1.2rem 0.4rem 0.4rem;
    border-radius: 999px;
    background: var(--bg-card);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-xs);
  }
  .sport-step:not(:last-child) { margin-right: 1.6rem; }
  .sport-step__label {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    white-space: nowrap;
  }
  .sport-step :global(.gradient-tile) { width: 2.3rem; height: 2.3rem; border-radius: 999px; }
  .sport-step :global(.sport-step__arrow) {
    position: absolute;
    right: -1.45rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-faint);
  }
  @media (max-width: 640px) {
    .sport-flow { flex-direction: column; align-items: center; }
    .sport-step:not(:last-child) { margin-right: 0; }
    .sport-step :global(.sport-step__arrow) { display: none; }
  }

  /* ---- Measure grid ---- */
  .measure-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.2vw, 1.5rem);
    margin-bottom: clamp(1rem, 2.2vw, 1.5rem);
  }
  .measure-card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: clamp(1.5rem, 2.6vw, 2rem);
    border-radius: 1.4rem;
    background: var(--bg-card);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-xs);
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 320ms ease;
  }
  .measure-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lift); }
  .measure-card__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
  .measure-card__title { font-family: var(--font-sans); font-size: clamp(1.25rem, 1.75vw, 1.45rem); font-weight: 600; letter-spacing: -0.03em; color: var(--ink); }
  .measure-card__body { font-size: 0.95rem; line-height: 1.7; color: var(--ink-muted); }
  @media (max-width: 720px) { .measure-grid { grid-template-columns: 1fr; } }

  /* ---- Edge Score panel ---- */
  .score-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: clamp(1.5rem, 2.6vw, 2.25rem);
    background: var(--gradient-panel);
    border: 1px solid #e8d9ec;
  }
  .score-panel__copy { flex: 1 1 22rem; }
  .score-panel__copy :global(.meta-label) { color: var(--ink); letter-spacing: 0.24em; }
  .score-panel__title {
    font-family: var(--font-sans);
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin-top: 0.9rem;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }
  .score-panel__body { font-size: 0.98rem; line-height: 1.7; color: var(--ink-muted); max-width: 34rem; }
  .score-panel__gauge {
    flex: 0 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem 2rem;
    border-radius: 1.4rem;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: var(--shadow-card);
  }
  .score-panel__window { color: var(--ink-muted); margin-bottom: 0.5rem; }
  .score-panel__num {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(2.75rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  /* ---------- Mobile (≤768px): every chapter reads centered ---------- */
  @media (max-width: 768px) {
    .about-page :is(h1, h2, h3, p, .section-title, .pull-quote) {
      text-align: center !important;
    }
    .about-page p { margin-left: auto; margin-right: auto; }

    /* Stat callout — center the copy when it stacks under the narrative. */
    .stat-callout { text-align: center; }

    /* Measure cards — icon, number and copy all centered. */
    .measure-card { text-align: center; align-items: center; }
    .measure-card__top { width: 100%; justify-content: center; gap: 0.85rem; }

    /* Edge Score panel — stack and center. */
    .score-panel { flex-direction: column; text-align: center; }
    /* Column flex: the 22rem basis would become a height — let it size to content. */
    .score-panel__copy { flex: 0 0 auto; }
    .score-panel__body { margin-left: auto; margin-right: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-callout__bars .bar span { transition: none; }
    .measure-card { transition: none; }
  }
</style>
