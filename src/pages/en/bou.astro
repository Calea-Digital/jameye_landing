  .bou-board__prizek { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--prize-gold); }
  .bou-board__prizev { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; color: #fff; }

  /* ===================== FIELD / CRESTS ===================== */
  .bou-field {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 1rem;
  }
  .bou-field__vs {
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    padding: 0 0.4rem;
  }
  .bou-crest {
    position: relative;
    flex: 1 1 220px;
    max-width: 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
    border-radius: var(--radius-2xl);
    background: var(--glass-card-bg);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow: hidden;
    transition: transform 400ms cubic-bezier(0.2, 0.85, 0.2, 1), border-color 250ms ease;
  }
  .bou-crest:hover { transform: translateY(-6px); border-color: var(--hairline-strong); }
  .bou-crest__glow {
    position: absolute;
    top: -40%; left: 50%; transform: translateX(-50%);
    width: 80%; height: 80%;
    background: radial-gradient(circle, color-mix(in srgb, var(--crest-color) 45%, transparent), transparent 70%);
    opacity: 0.5;
    pointer-events: none;
  }
  .bou-crest__flag { position: relative; font-size: 1.4rem; line-height: 1; margin-bottom: 0.85rem; }
  .bou-crest__logo {
    position: relative;
    width: 6rem; height: 6rem;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1.1rem;
    /* White disc behind the crest so dark/transparent logos stay legible. */
    background: #fff;
    border-radius: 9999px;
    padding: 0.9rem;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
  }
  .bou-crest__logo img { max-width: 100%; max-height: 100%; object-fit: contain; animation: bouFloat 5.5s ease-in-out infinite; }
  .bou-crest:nth-of-type(3) .bou-crest__logo img { animation-delay: 1.2s; }
  .bou-crest:hover .bou-crest__logo img { animation-play-state: paused; }
  .bou-crest__name { position: relative; font-family: var(--font-sans); font-size: 1.4rem; font-weight: 500; letter-spacing: -0.02em; color: #fff; margin-bottom: 0.3rem; }
  .bou-crest__loc { position: relative; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); }

  .bou-crest--more { justify-content: center; border-style: dashed; }
  .bou-crest__plus {
    display: inline-flex; align-items: center; justify-content: center;
    width: 3.25rem; height: 3.25rem; border-radius: 9999px; margin-bottom: 1rem;
    color: var(--brand-lavender);
    background: rgba(126, 59, 255, 0.12); border: 1px solid rgba(126, 59, 255, 0.35);
  }
  .bou-crest__moretxt { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; color: var(--ink-muted); line-height: 1.5; max-width: 12rem; }

  @media (max-width: 640px) {
    .bou-field__vs { width: 100%; padding: 0.25rem 0; }
    .bou-crest { max-width: none; flex-basis: 100%; }
  }

  /* ===================== TIMELINE ===================== */
  .bou-timeline {
    position: relative;
    max-width: 46rem;
    margin: 0 auto;
    padding-left: 2rem;
  }
  .bou-timeline::before {
    content: '';
    position: absolute;
    left: 0.32rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: linear-gradient(180deg, var(--brand-purple), rgba(126, 59, 255, 0.15));
  }
  /* A light pulse travelling down the line. */
  .bou-timeline__pulse {
    position: absolute;
    left: 0.32rem;
    top: 0;
    width: 8px; height: 8px;
    margin-left: -3px;
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 0 14px 3px rgba(126, 59, 255, 0.9);
    z-index: 1;
    animation: bouTlPulse 4.5s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  @keyframes bouTlPulse {
    0%   { top: 0%;   opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }
  .bou-tl {
    position: relative;
    padding: 0 0 2rem 1.75rem;
    display: grid;
    grid-template-columns: auto;
  }
  .bou-tl:last-child { padding-bottom: 0; }
  .bou-tl__dot {
    position: absolute;
    left: calc(-2rem + 0.32rem);
    top: 0.35rem;
    transform: translateX(-50%);
    width: 0.85rem; height: 0.85rem;
    border-radius: 9999px;
    background: var(--bg-card);
    border: 2px solid var(--hairline-strong);
  }
  .bou-tl--active .bou-tl__dot {
    background: var(--brand-purple);
    border-color: var(--brand-lavender);
    box-shadow: 0 0 0 4px rgba(126, 59, 255, 0.18), 0 0 16px rgba(126, 59, 255, 0.7);
    /* Keep translateX(-50%) inside the keyframes so the pulse scale doesn't
       clobber the centering transform (which would shift the dot off the line). */
    animation: bouTlDotPulse 2.4s ease-in-out infinite;
  }
  @keyframes bouTlDotPulse {
    0%, 100% { transform: translateX(-50%) scale(1); }
    50%      { transform: translateX(-50%) scale(0.8); }
  }
  .bou-tl__when {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-lavender);
    margin-bottom: 0.4rem;
  }
  .bou-tl--active .bou-tl__when { color: var(--win-emerald); }
  .bou-tl__title { font-family: var(--font-sans); font-size: 1.2rem; font-weight: 500; letter-spacing: -0.02em; margin-bottom: 0.3rem; }
  .bou-tl__body { font-size: 0.92rem; line-height: 1.6; color: var(--ink-muted); max-width: 38rem; }

  /* ===================== FAQ ===================== */
  .bou-faq { display: flex; flex-direction: column; gap: 0.65rem; }
  .bou-faq__item {
    border-radius: var(--radius-lg);
    background: var(--glass-card-bg);
    border: 1px solid var(--hairline);
    overflow: hidden;
    transition: border-color 200ms ease, background 200ms ease;
  }
  .bou-faq__item[open] { border-color: var(--hairline-strong); background: rgba(255, 255, 255, 0.045); }
  .bou-faq__q {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.1rem 1.35rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-sans);
    font-size: 1.02rem;
    font-weight: 500;
    color: #fff;
  }
  .bou-faq__q::-webkit-details-marker { display: none; }
  .bou-faq__icon { flex: none; color: var(--brand-lavender); transition: transform 250ms ease; }
  .bou-faq__item[open] .bou-faq__icon { transform: rotate(45deg); }
  .bou-faq__a {
    padding: 0 1.35rem 1.2rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ink-muted);
    max-width: 52rem;
  }

  /* ===================== FINAL CTA ===================== */
  .bou-final {
    position: relative;
    text-align: center;
    padding-block: clamp(4rem, 10vw, 7rem);
    overflow: hidden;
  }
  .bou-final__ghost {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(12rem, 30vw, 28rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.025);
  }
  .bou-final__eyebrow { margin-bottom: 1.5rem; }
  .bou-final__title { font-size: clamp(3rem, 8vw, 6rem); }
  .bou-final__body {
    margin: 1.75rem auto 0;
    max-width: 34rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .bou-board__fill { transition: none; }
    .bou-hero::before,
    .bou-hero::after,
    .bou-hero__title .ital-grad,
    .bou-final__title .ital-grad,
    .bou-stat,
    .bou-crest__logo img,
    .bou-timeline__pulse,
    .bou-tl--active .bou-tl__dot { animation: none !important; }
    .bou-stage__layer,
    .bou-sstep { transition: none; }
  }
</style>

<script>
  // ---- Scroll reveal (mirrors the home page) ----
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-scroll]').forEach((el) => observer.observe(el));

  // ---- Live campus board: count-up scores + Edge Score gauge ----
  document.querySelectorAll<HTMLElement>('[data-board]').forEach((board) => {
    let played = false;
    const counters = Array.from(board.querySelectorAll<HTMLElement>('[data-count]'));
    const edgeNum = board.querySelector<HTMLElement>('[data-edge-num]');
    const edgeFill = board.querySelector<HTMLElement>('[data-edge-fill]');
    const edgeTarget = Number(board.dataset.edge ?? 0);
    const edgeMax = Number(board.dataset.edgeMax ?? 1000);

    const animateNumber = (el: HTMLElement, target: number, dur = 1400) => {
      let start = 0;
      const tick = (ts: number) => {
        if (!start) start = ts;
        const p = Math.min(1, (ts - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(eased * target));
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = String(target);
      };
      requestAnimationFrame(tick);
    };

    const play = () => {
      if (played) return;
      played = true;
      counters.forEach((el) => animateNumber(el, Number(el.dataset.count ?? 0)));
      if (edgeNum) animateNumber(edgeNum, edgeTarget);
      if (edgeFill) requestAnimationFrame(() => { edgeFill.style.width = `${(edgeTarget / edgeMax) * 100}%`; });
    };

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) play(); });
    }, { threshold: 0.35 });
    io.observe(board);
  });

  // ---- Five steps: scroll-driven active step ----
  document.querySelectorAll<HTMLElement>('[data-scrolly]').forEach((root) => {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-step-panel]'));
    const layers = Array.from(root.querySelectorAll<HTMLElement>('[data-stage]'));
    const segs = Array.from(root.querySelectorAll<HTMLElement>('[data-seg]'));
    const curEl = root.querySelector<HTMLElement>('[data-step-cur]');
    if (!panels.length) return;

    let active = 0;
    const setActive = (idx: number) => {
      if (idx === active) return;
      active = idx;
      panels.forEach((p, i) => (p.dataset.active = i === idx ? 'true' : 'false'));
      layers.forEach((l, i) => (l.dataset.active = i === idx ? 'true' : 'false'));
      segs.forEach((s, i) => (s.dataset.active = i <= idx ? 'true' : 'false'));
      if (curEl) curEl.textContent = String(idx + 1);
    };

    // A thin band across the viewport centre — whichever panel crosses it wins.
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(Number(entry.target.getAttribute('data-step-panel')));
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );
    panels.forEach((p) => io.observe(p));
  });

  // ---- FAQ: keep it a single-open accordion ----
  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('.bou-faq__item'));
  faqItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (item.open) faqItems.filter((i) => i !== item).forEach((i) => (i.open = false));
    });
  });
</script>
